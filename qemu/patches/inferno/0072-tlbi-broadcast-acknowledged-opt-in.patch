+/*
+ * QEMU_TLBI_ACK=1 (experimental): a synced flush (TLBI ... IS) without the
+ * exclusive section. The other CPUs already have their flush queued; behind
+ * it each gets an acknowledgement, the source flushes itself at once and
+ * waits (2 ms at most, and not while it has queued work of its own) until
+ * every other CPU has run its flush. async_safe_run_on_cpu stopped all of
+ * them instead, at every broadcast TLB invalidation of the guest.
+ */
+typedef struct TLBFlushAck {
+    int pending;
+    int refs;
+} TLBFlushAck;
+
+static void tlb_flush_ack_put(TLBFlushAck *ack)
+{
+    if (qatomic_fetch_dec(&ack->refs) == 1) {
+        g_free(ack);
+    }
+}
+
+static void tlb_flush_ack_work(CPUState *cpu, run_on_cpu_data d)
+{
+    TLBFlushAck *ack = d.host_ptr;
+
+    qatomic_dec(&ack->pending);
+    tlb_flush_ack_put(ack);
+}
+
+static bool tlb_flush_ack_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        const char *v = getenv("QEMU_TLBI_ACK");
+        enabled = v && v[0] == '1';
+    }
+    return enabled;
+}
+
+/*
+ * The source's part of a synced flush, after the other CPUs' flushes were
+ * queued: @fn(src, @d) under the exclusive section, or (QEMU_TLBI_ACK=1)
+ * right away and then wait for the others.
+ */
+static void tlb_flush_synced_local(CPUState *src, run_on_cpu_func fn,
+                                   run_on_cpu_data d)
+{
+    CPUState *cpu;
+    TLBFlushAck *ack;
+    int others = 0;
+    int64_t deadline;
+
+    if (!tlb_flush_ack_enabled() || bql_locked() || current_cpu != src) {
+        async_safe_run_on_cpu(src, fn, d);
+        return;
+    }
+    CPU_FOREACH(cpu) {
+        if (cpu != src) {
+            others++;
+        }
+    }
+    ack = g_new(TLBFlushAck, 1);
+    ack->pending = others;
+    ack->refs = others + 1;
+    CPU_FOREACH(cpu) {
+        if (cpu != src) {
+            async_run_on_cpu(cpu, tlb_flush_ack_work, RUN_ON_CPU_HOST_PTR(ack));
+        }
+    }
+    fn(src, d);
+    deadline = get_clock() + 2 * SCALE_MS;
+    while (qatomic_read(&ack->pending) > 0) {
+        if (qatomic_read(&src->work_list.sqh_first) != NULL ||
+            get_clock() > deadline) {
+            break;
+        }
+        cpu_relax();
+    }
+    tlb_flush_ack_put(ack);
+}
+
