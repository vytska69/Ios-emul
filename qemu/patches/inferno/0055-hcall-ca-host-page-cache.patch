+/*
+ * Host addresses of the guest pages a hypercall reads or writes, so a pixel
+ * costs a pointer access instead of a TLB lookup. Each page is probed once
+ * (probe_access: faults, watchpoints, dirty tracking); MMIO and accesses that
+ * cross a page go through the normal path.
+ */
+typedef struct CaCache {
+    uint64_t page[4];
+    uint8_t *host[4];
+    unsigned next;
+} CaCache;
+
+static inline void ca_cache_init(CaCache *c)
+{
+    for (int i = 0; i < 4; i++) {
+        c->page[i] = (uint64_t)-1;
+        c->host[i] = NULL;
+    }
+    c->next = 0;
+}
+
+static inline uint8_t *ca_cache_find(CPUARMState *env, CaCache *c, uint64_t a,
+                                     MMUAccessType type, int mmu, uintptr_t ra)
+{
+    uint64_t pg = a & TARGET_PAGE_MASK, off = a - pg;
+    if (off > TARGET_PAGE_SIZE - 4) {
+        return NULL;
+    }
+    for (int i = 0; i < 4; i++) {
+        if (c->page[i] == pg) {
+            return c->host[i] + off;
+        }
+    }
+    void *h = probe_access(env, a, 4, type, mmu, ra);
+    if (!h) {
+        return NULL;
+    }
+    unsigned i = c->next++ & 3;
+    c->page[i] = pg;
+    c->host[i] = (uint8_t *)h - off;
+    return h;
+}
+
+static inline uint32_t ca_ld32(CPUARMState *env, CaCache *c, uint64_t a, int mmu, uintptr_t ra)
+{
+    uint8_t *h = ca_cache_find(env, c, a, MMU_DATA_LOAD, mmu, ra);
+    return h ? ldl_le_p(h) : cpu_ldl_le_mmuidx_ra(env, a, mmu, ra);
+}
+
+static inline void ca_st32(CPUARMState *env, CaCache *c, uint64_t a, uint32_t v, int mmu, uintptr_t ra)
+{
+    uint8_t *h = ca_cache_find(env, c, a, MMU_DATA_STORE, mmu, ra);
+    if (h) {
+        stl_le_p(h, v);
+    } else {
+        cpu_stl_le_mmuidx_ra(env, a, v, mmu, ra);
+    }
+}
