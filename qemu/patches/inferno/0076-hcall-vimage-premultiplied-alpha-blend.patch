+/*
+ * vImage (18A373) vAlpha_Blend_Premultiplied_BGRA_8888_CV_vec(top, back, dest):
+ * the row loop behind vImagePremultipliedAlphaBlend_BGRA8888, three
+ * vImage_Buffer (data, height, width, rowBytes), the size taken from dest. Per
+ * row its NEON loop does the first width & ~7 pixels as
+ * sat(t + b - round(b * ta / 255)) and its scalar loop the rest as
+ * round((t * 255 + b * (255 - ta)) / 255); both written from its code and
+ * checked against it (scripts/vgpu-check/check_valpha.py).
+ */
+static inline uint32_t vimage_blend_vec(uint32_t t, uint32_t b)
+{
+    uint32_t a = t >> 24, o = 0;
+
+    for (int c = 0; c < 32; c += 8) {
+        uint32_t bc = (b >> c) & 0xff, tc = (t >> c) & 0xff;
+        uint32_t m = (((bc * a + 0x80) & 0xffff) * 0x101) >> 16;
+        uint32_t d = tc + ((bc - m) & 0xff);
+        o |= (d > 255 ? 255 : d) << c;
+    }
+    return o;
+}
+
+static inline uint32_t vimage_blend_scalar(uint32_t t, uint32_t b)
+{
+    uint32_t ia = (t >> 24) ^ 0xff, o = 0;
+
+    for (int c = 0; c < 32; c += 8) {
+        uint32_t v = (ia * ((b >> c) & 0xff) + ((t >> c) & 0xff) * 255) * 257;
+        o |= (v > 0xff7f7f ? 255 : (v + 0x8080) >> 16) << c;
+    }
+    return o;
+}
+
+static void ios_hcall_vimage_alpha_blend(CPUARMState *env, uintptr_t ra)
+{
+    uint64_t *x = env->xregs;
+    int mmu = arm_env_mmu_index(env);
+    CaCache tc, bc, dc;
+    uint64_t top = cpu_ldq_le_mmuidx_ra(env, x[0], mmu, ra);
+    uint64_t top_rb = cpu_ldq_le_mmuidx_ra(env, x[0] + 0x18, mmu, ra);
+    uint64_t back = cpu_ldq_le_mmuidx_ra(env, x[1], mmu, ra);
+    uint64_t back_rb = cpu_ldq_le_mmuidx_ra(env, x[1] + 0x18, mmu, ra);
+    uint64_t dst = cpu_ldq_le_mmuidx_ra(env, x[2], mmu, ra);
+    uint64_t height = cpu_ldq_le_mmuidx_ra(env, x[2] + 8, mmu, ra);
+    uint64_t width = cpu_ldq_le_mmuidx_ra(env, x[2] + 0x10, mmu, ra);
+    uint64_t dst_rb = cpu_ldq_le_mmuidx_ra(env, x[2] + 0x18, mmu, ra);
+    uint64_t vec = width >= 8 ? width & ~(uint64_t)7 : 0;
+
+    ca_cache_init(&tc);
+    ca_cache_init(&bc);
+    ca_cache_init(&dc);
+    for (uint64_t y = 0; y < height; y++) {
+        for (uint64_t i = 0; i < width; i++) {
+            uint32_t t = ca_ld32(env, &tc, top + 4 * i, mmu, ra);
+            uint32_t b = ca_ld32(env, &bc, back + 4 * i, mmu, ra);
+            ca_st32(env, &dc, dst + 4 * i,
+                    i < vec ? vimage_blend_vec(t, b) : vimage_blend_scalar(t, b),
+                    mmu, ra);
+        }
+        top += top_rb;
+        back += back_rb;
+        dst += dst_rb;
+    }
+    x[0] = 0; /* kvImageNoError */
+}
