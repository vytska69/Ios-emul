+/* QEMU_FULL_ASID_FLUSH=1 in the environment: flush everything, as before. */
+static bool arm_full_asid_flush(void)
+{
+    static int full = -1;
+
+    if (full < 0) {
+        const char *v = getenv("QEMU_FULL_ASID_FLUSH");
+        full = v && v[0] == '1';
+    }
+    return full;
+}
