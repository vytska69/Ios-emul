+/*
+ * For a change of address space ID: flushes every entry of @fullmap's TLBs, and
+ * only the lower half of the address space (TTBR0; the user's) from @halfmap's,
+ * keeping the kernel's (TTBR1, the same in every address space). The jump cache
+ * keeps its entries for upper-half PCs the same way. A full flush made the
+ * kernel find all its code and data again after every context switch.
+ */
+static inline bool tlb_entry_is_upper(const CPUTLBEntry *te)
+{
+    uint64_t a = te->addr_read != -1 ? te->addr_read
+               : te->addr_write != -1 ? te->addr_write : te->addr_code;
+    return (a >> 63) != 0;
+}
+
+void tlb_flush_lower_half(CPUState *cpu, MMUIdxMap fullmap, MMUIdxMap halfmap)
+{
+    int64_t now = get_clock_realtime();
+    MMUIdxMap work;
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+
+    assert_cpu_is_self(cpu);
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    for (work = fullmap & cpu->neg.tlb.c.dirty; work != 0; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        tlb_flush_one_mmuidx_locked(cpu, mmu_idx, now);
+        cpu->neg.tlb.c.dirty &= ~(1 << mmu_idx);
+    }
+    for (work = halfmap & ~fullmap & cpu->neg.tlb.c.dirty; work != 0;
+         work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        CPUTLBDesc *d = &cpu->neg.tlb.d[mmu_idx];
+        CPUTLBDescFast *f = cpu_tlb_fast(cpu, mmu_idx);
+        size_t n = tlb_n_entries(f);
+
+        for (size_t i = 0; i < n; i++) {
+            CPUTLBEntry *te = &f->table[i];
+            if (!tlb_entry_is_empty(te) && !tlb_entry_is_upper(te)) {
+                memset(te, -1, sizeof(*te));
+                if (d->n_used_entries) {
+                    d->n_used_entries--;
+                }
+            }
+        }
+        for (int k = 0; k < CPU_VTLB_SIZE; k++) {
+            CPUTLBEntry *te = &d->vtable[k];
+            if (!tlb_entry_is_empty(te) && !tlb_entry_is_upper(te)) {
+                memset(te, -1, sizeof(*te));
+            }
+        }
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+
+    if (jc) {
+        for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+            if ((jc->array[i].pc >> 63) == 0) {
+                qatomic_set(&jc->array[i].tb, NULL);
+            }
+        }
+    }
+    qatomic_set(&cpu->neg.tlb.c.part_flush_count,
+                cpu->neg.tlb.c.part_flush_count + 1);
+}
+
