 {
@@ -2681,7 +2693,24 @@ static void vmsa_ttbr_write(CPUARMState *env, const ARMCPRegInfo *ri,
     if (cpreg_field_is_64bit(ri) &&
         extract64(raw_read(env, ri) ^ value, 48, 16) != 0) {
         ARMCPU *cpu = env_archcpu(env);
-        tlb_flush(CPU(cpu));
+        /*
+         * TTBR0_EL1 holding the ASID (TCR_EL1.A1 = 0), outside an EL2&0
+         * regime: only the user's half of the EL1&0 TLBs depends on it (a
+         * guest like XNU keeps the kernel global in TTBR1), and the TLBs of
+         * other regimes and of physical addresses not at all.
+         */
+        if (ri->crn == 2 && ri->crm == 0 && ri->opc1 == 0 && ri->opc2 == 0 &&
+            ri->state == ARM_CP_STATE_AA64 &&
+            !(env->cp15.tcr_el[1] & TTBCR_A1) &&
+            !(arm_hcr_el2_eff(env) & HCR_E2H) &&
+            !arm_full_asid_flush()) {
+            tlb_flush_lower_half(CPU(cpu), ARMMMUIdxBit_E10_0,
+                                 ARMMMUIdxBit_E10_1 | ARMMMUIdxBit_E10_1_PAN |
+                                 ARMMMUIdxBit_GE10_1 |
+                                 ARMMMUIdxBit_GE10_1_PAN);
+        } else {
+            tlb_flush(CPU(cpu));
+        }
     }
     raw_write(env, ri, value);
 }
