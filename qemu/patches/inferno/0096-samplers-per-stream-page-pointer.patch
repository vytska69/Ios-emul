+/*
+ * One stream of pixel addresses (a texture row, the output) and the host page
+ * it last used: most pixels of a span fall in the page of the one before, so
+ * one compare finds them, where ca_ld32/ca_st32 searched a page cache each
+ * time. A pixel across a page boundary or outside RAM goes the slow way.
+ */
+typedef struct CaOne {
+    uint64_t lo;    /* guest page of h; at first a non-canonical address */
+    uint8_t *h;
+} CaOne;
+
+/* No pixel address is within a page of 0x8000000000000001 (not canonical). */
+#define CA_ONE_INIT { 0x8000000000000001ull, NULL }
+
+static uint32_t __attribute__((noinline)) ca_ld32_one_slow(CPUARMState *env, CaOne *o,
+                                               CaCache *c, uint64_t a,
+                                               int mmu, uintptr_t ra)
+{
+    uint8_t *h = ca_cache_find(env, c, a, MMU_DATA_LOAD, mmu, ra);
+
+    if (!h) {
+        return cpu_ldl_le_mmuidx_ra(env, a, mmu, ra);
+    }
+    o->lo = a & TARGET_PAGE_MASK;
+    o->h = h - (a - o->lo);
+    return ldl_le_p(h);
+}
+
+static inline uint32_t ca_ld32_one(CPUARMState *env, CaOne *o, CaCache *c,
+                                   uint64_t a, int mmu, uintptr_t ra)
+{
+    uint64_t off = a - o->lo;
+
+    if (likely(off <= TARGET_PAGE_SIZE - 4)) {
+        return ldl_le_p(o->h + off);
+    }
+    return ca_ld32_one_slow(env, o, c, a, mmu, ra);
+}
+
+static void __attribute__((noinline)) ca_st32_one_slow(CPUARMState *env, CaOne *o,
+                                           CaCache *c, uint64_t a, uint32_t v,
+                                           int mmu, uintptr_t ra)
+{
+    uint8_t *h = ca_cache_find(env, c, a, MMU_DATA_STORE, mmu, ra);
+
+    if (!h) {
+        cpu_stl_le_mmuidx_ra(env, a, v, mmu, ra);
+        return;
+    }
+    o->lo = a & TARGET_PAGE_MASK;
+    o->h = h - (a - o->lo);
+    stl_le_p(h, v);
+}
+
+static inline void ca_st32_one(CPUARMState *env, CaOne *o, CaCache *c,
+                               uint64_t a, uint32_t v, int mmu, uintptr_t ra)
+{
+    uint64_t off = a - o->lo;
+
+    if (likely(off <= TARGET_PAGE_SIZE - 4)) {
+        stl_le_p(o->h + off, v);
+        return;
+    }
+    ca_st32_one_slow(env, o, c, a, v, mmu, ra);
+}
