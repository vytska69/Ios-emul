+/*
+ * A synchronous exception (SVC, a data or instruction abort, GENTER and the
+ * like) only changes this CPU's registers, unless it is a PSCI call or a
+ * semihosting call, or the PMU's EL change hooks have work. iOS takes one
+ * for every syscall and every PPL call, and taking the BQL for each made the
+ * vCPUs wait for each other. QEMU_EXC_NOBQL=0 takes it as before.
+ */
+bool arm_cpu_do_interrupt_needs_bql(CPUState *cs)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        const char *v = getenv("QEMU_EXC_NOBQL");
+        enabled = !(v && v[0] == '0');
+    }
+    if (!enabled || qemu_loglevel_mask(CPU_LOG_INT) ||
+        cs->exception_index == EXCP_SEMIHOST ||
+        arm_is_psci_call(cpu, cs->exception_index) ||
+        arm_el_change_hooks_active(cpu) ||
+        !arm_el_is_aa64(env, env->exception.target_el)) {
+        return true;
     }
+    return false;
 }
 
