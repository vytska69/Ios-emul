-#define DO_3OP_FAST_S(NAME, FUNC, OPV, MUL)                                 \
+/* The rounding error of each lane of z = x + y or z = x * y, nonzero if inexact. */
+static inline float32x4_t vf32_err(float32x4_t x, float32x4_t y,
+                                   float32x4_t z, bool mul)
+{
+    if (mul) {
+        return vfmaq_f32(vnegq_f32(z), x, y);
+    }
+    float32x4_t bb = vsubq_f32(z, x);
+    return vaddq_f32(vsubq_f32(x, vsubq_f32(z, bb)), vsubq_f32(y, bb));
+}
