+/*
+ * Sends the guest's sound to the host. Where a piece was left out (a part of the
+ * ring the guest filled too late), the sound used to jump from one sample to an
+ * unrelated one: a click, the crackle heard in every sound. Now the last 64
+ * frames (1.3 ms) are held back, and at such a cut they fade out while the next
+ * piece fades in. Everything is taken: what the host has no room for yet waits
+ * in a queue (dropped past 16 KB).
+ */
+#define MCA_XF 64
+
+static void apple_mca_flush(AppleMCAState *s)
+{
+    if (s->queued_len) {
+        uint32_t w = AUD_write(s->voice, s->queued, s->queued_len);
+        memmove(s->queued, s->queued + w, s->queued_len - w);
+        s->queued_len -= w;
+    }
+}
+
+static void apple_mca_send(AppleMCAState *s, const void *data, uint32_t len)
+{
+    uint32_t w = 0;
+
+    apple_mca_flush(s);
+    if (!s->queued_len) {
+        w = AUD_write(s->voice, (void *)data, len);
+    }
+    len -= w;
+    len = MIN(len, (uint32_t)sizeof(s->queued) - s->queued_len);
+    memcpy(s->queued + s->queued_len, (const uint8_t *)data + w, len);
+    s->queued_len += len;
+}
+
+static void apple_mca_out(AppleMCAState *s, const uint8_t *data, uint32_t len)
+{
+    const int16_t *in = (const int16_t *)data;
+    uint32_t frames = len / MCA_FRAME, i = 0;
+
+    if (s->splice && s->hold_frames == MCA_XF && frames >= MCA_XF) {
+        int16_t mix[MCA_XF * 2];
+        for (uint32_t k = 0; k < MCA_XF; k++) {
+            int32_t a = MCA_XF - k, b = k;
+            for (int c = 0; c < 2; c++) {
+                mix[k * 2 + c] = (s->hold[k * 2 + c] * a + in[k * 2 + c] * b) /
+                                 MCA_XF;
+            }
+        }
+        memcpy(s->hold, mix, sizeof(mix));
+        i = MCA_XF;
+    }
+    s->splice = false;
+    for (; i < frames; i++) {
+        if (s->hold_frames == MCA_XF) {
+            /* The oldest held frame goes out; batch the common case. */
+            uint32_t run = frames - i;
+            if (run > MCA_XF) {
+                apple_mca_send(s, s->hold, MCA_XF * MCA_FRAME);
+                apple_mca_send(s, in + i * 2, (run - MCA_XF) * MCA_FRAME);
+                memcpy(s->hold, in + (frames - MCA_XF) * 2, MCA_XF * MCA_FRAME);
+                return;
+            }
+            apple_mca_send(s, s->hold, MCA_FRAME);
+            memmove(s->hold, s->hold + 2, (MCA_XF - 1) * MCA_FRAME);
+            s->hold_frames--;
+        }
+        s->hold[s->hold_frames * 2] = in[i * 2];
+        s->hold[s->hold_frames * 2 + 1] = in[i * 2 + 1];
+        s->hold_frames++;
+    }
+}
