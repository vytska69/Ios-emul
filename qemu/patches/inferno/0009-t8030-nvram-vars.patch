diff --git a/hw/arm/apple-silicon/t8030.c b/hw/arm/apple-silicon/t8030.c
index 3ad7517..8c87630 100644
--- a/hw/arm/apple-silicon/t8030.c
+++ b/hw/arm/apple-silicon/t8030.c
@@ -531,6 +531,21 @@ static void t8030_memory_setup(AppleT8030MachineState *t8030)
     }
     apple_nvram_load(nvram);
 
+    if (t8030->nvram_vars != NULL) {
+        g_auto(GStrv) vars = g_strsplit(t8030->nvram_vars, ";", -1);
+        for (char **var = vars; *var != NULL; var++) {
+            g_auto(GStrv) kv = g_strsplit(*var, "=", 2);
+            if (kv[0] == NULL || kv[0][0] == '\0') {
+                continue;
+            }
+            info_report("NVRAM: %s=%s", kv[0], kv[1] ? kv[1] : "");
+            env_set(nvram, kv[0], kv[1] ? kv[1] : "", 0);
+        }
+        /* Only for the first boot: guest reboots run this again and must keep what it changed. */
+        g_free(t8030->nvram_vars);
+        t8030->nvram_vars = NULL;
+    }
+
     info_report("Boot Mode: %u", t8030->boot_info.boot_mode);
     switch (t8030->boot_info.boot_mode) {
     case kAppleBootModeEnterRecovery:
@@ -3066,6 +3081,7 @@ PROP_STR_GETTER_SETTER(trustcache_filename);
 PROP_STR_GETTER_SETTER(ticket_filename);
 PROP_STR_GETTER_SETTER(sep_rom_filename);
 PROP_STR_GETTER_SETTER(sep_fw_filename);
+PROP_STR_GETTER_SETTER(nvram_vars);
 PROP_STR_GETTER_SETTER(securerom_filename);
 PROP_STR_GETTER_SETTER(usb_conn_addr);
 PROP_VISIT_GETTER_SETTER(uint16, usb_conn_port);
@@ -3110,6 +3126,10 @@ static void t8030_class_init(ObjectClass *klass, const void *data)
     object_class_property_add_str(klass, "sep-fw", t8030_get_sep_fw_filename,
                                   t8030_set_sep_fw_filename);
     object_class_property_set_description(klass, "sep-fw", "SEP Firmware");
+    object_class_property_add_str(klass, "nvram-vars", t8030_get_nvram_vars,
+                                  t8030_set_nvram_vars);
+    object_class_property_set_description(
+        klass, "nvram-vars", "NVRAM variables to set before boot (name=value;...)");
     object_class_property_add_str(klass, "securerom",
                                   t8030_get_securerom_filename,
                                   t8030_set_securerom_filename);
diff --git a/include/hw/arm/apple-silicon/t8030.h b/include/hw/arm/apple-silicon/t8030.h
index d45800a..a4285bb 100644
--- a/include/hw/arm/apple-silicon/t8030.h
+++ b/include/hw/arm/apple-silicon/t8030.h
@@ -59,6 +59,8 @@ typedef struct {
     char *ticket_filename;
     char *sep_rom_filename;
     char *sep_fw_filename;
+    /* "name=value;name=value" NVRAM variables set before boot. */
+    char *nvram_vars;
     char *securerom_filename;
     uint32_t sio_protocol;
     uint32_t build_version;
