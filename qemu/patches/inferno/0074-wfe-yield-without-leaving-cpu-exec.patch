@@ -457,10 +458,35 @@ void HELPER(wfe)(CPUARMState *env)
     HELPER(yield)(env);
 }
 
+/*
+ * With MTTCG every vCPU has its own thread, so YIELD and WFE need not leave
+ * cpu_exec for other vCPUs to run: giving the host CPU away is enough, and
+ * the TB still ends here, so pending interrupts are taken as before. Leaving
+ * cpu_exec went through the BQL in the thread loop each time, and a guest
+ * spinlock that waits with WFE (XNU's hw_lock_bit, ldaxrb; cmp; b.eq; wfe)
+ * did that on every turn, mostly while all vCPUs were contending for it.
+ * QEMU_WFE_EXIT=1 leaves cpu_exec as before.
+ */
+static bool arm_yield_in_place(void)
+{
+    static int in_place = -1;
+
+    if (in_place < 0) {
+        const char *v = getenv("QEMU_WFE_EXIT");
+        in_place = !(v && v[0] == '1') && qemu_tcg_mttcg_enabled();
+    }
+    return in_place;
+}
+
 void HELPER(yield)(CPUARMState *env)
 {
     CPUState *cs = env_cpu(env);
 
+    if (arm_yield_in_place()) {
+        g_thread_yield();
+        return;
+    }
+
