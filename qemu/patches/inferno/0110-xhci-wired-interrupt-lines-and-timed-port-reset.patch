+static void xhci_port_reset_timer(void *opaque)
+{
+    XHCIPort *port = opaque;
+
+    /* A detach or controller reset since then cleared PR: nothing to finish. */
+    if (!(port->portsc & PORTSC_PR) || !xhci_port_have_device(port)) {
+        port->portsc &= ~PORTSC_PR;
+        return;
+    }
+    xhci_port_reset_done(port, false);
+}
+
+static void xhci_port_reset(XHCIPort *port, bool warm_reset)
+{
+    trace_usb_xhci_port_reset(port->portnr, warm_reset);
+
+    if (!xhci_port_have_device(port)) {
+        return;
+    }
+
+    if (!warm_reset && port->xhci->port_reset_us && port->reset_timer &&
+        port->uport->dev->speed != USB_SPEED_SUPER) {
+        /*
+         * A real USB 2 port signals reset for 10 ms or more, with PR read
+         * back as 1. iOS's host driver writes PR again while it reads 0, so
+         * an instant reset turns into a storm of resets and port status
+         * change events that fills the event ring.
+         */
+        if (port->portsc & PORTSC_PR) {
+            return;
+        }
+        usb_device_reset(port->uport->dev);
+        port->portsc |= PORTSC_PR;
+        timer_mod(port->reset_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (int64_t)port->xhci->port_reset_us * 1000);
+        return;
+    }
+
+    usb_device_reset(port->uport->dev);
+    xhci_port_reset_done(port, warm_reset);
+}
