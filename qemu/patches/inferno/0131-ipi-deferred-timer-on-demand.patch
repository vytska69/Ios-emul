diff --git a/hw/arm/apple-silicon/a13.c b/hw/arm/apple-silicon/a13.c
index 67461c9..c1a26b1 100644
--- a/hw/arm/apple-silicon/a13.c
+++ b/hw/arm/apple-silicon/a13.c
@@ -121,6 +121,32 @@ static QTAILQ_HEAD(, AppleA13Cluster) clusters =
 static uint64_t ipi_cr = kDeferredIPITimerDefault;
 static QEMUTimer *ipicr_timer = NULL;
 
+/*
+ * The deferred-IPI timer used to tick every ipi_cr (64 us) for the whole run,
+ * taking the BQL ~15000 times a second even with nothing queued. It now runs
+ * only while a deferred or no-wake IPI waits. QEMU_IPI_TIMER_ALWAYS=1 restores
+ * the old free-running tick.
+ */
+static bool apple_a13_ipi_timer_always(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *v = getenv("QEMU_IPI_TIMER_ALWAYS");
+        on = v && v[0] == '1';
+    }
+    return on;
+}
+
+static bool apple_a13_ipi_pending(void);
+
+/* A deferred or no-wake IPI was queued: make sure the timer will see it. */
+static void apple_a13_ipi_timer_arm(void)
+{
+    if (ipicr_timer && ipi_cr && !timer_pending(ipicr_timer)) {
+        timer_mod_ns(ipicr_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ipi_cr);
+    }
+}
+
 bool apple_a13_is_asleep(const AppleA13State *acpu)
 {
     return CPU(acpu)->halted;
@@ -320,7 +346,25 @@ static void apple_a13_cluster_ipicr_tick(void *opaque)
         apple_a13_cluster_tick(cluster);
     }
 
-    timer_mod_ns(ipicr_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ipi_cr);
+    if (ipi_cr && (apple_a13_ipi_timer_always() || apple_a13_ipi_pending())) {
+        timer_mod_ns(ipicr_timer,
+                     qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ipi_cr);
+    }
+}
+
+static bool apple_a13_ipi_pending(void)
+{
+    AppleA13Cluster *c;
+
+    QTAILQ_FOREACH (c, &clusters, next) {
+        for (uint32_t i = 0; i < A13_MAX_CPU; ++i) {
+            if (qatomic_read(&c->deferredIPI[i]) ||
+                qatomic_read(&c->noWakeIPI[i])) {
+                return true;
+            }
+        }
+    }
+    return false;
 }
 
 
@@ -378,6 +422,7 @@ static void apple_a13_ipi_rr_local(CPUARMState *env, const ARMCPRegInfo *ri,
     case IPI_RR_TYPE_NOWAKE:
         if (apple_a13_is_asleep(dst_acpu)) {
             c->noWakeIPI[acpu->cpu_id] |= BIT32(dst_cpu_id);
+            apple_a13_ipi_timer_arm();
         } else {
             apple_a13_deliver_ipi(dst_acpu, acpu->cpu_id,
                                   IPI_RR_TYPE_IMMEDIATE);
@@ -385,6 +430,7 @@ static void apple_a13_ipi_rr_local(CPUARMState *env, const ARMCPRegInfo *ri,
         break;
     case IPI_RR_TYPE_DEFERRED:
         c->deferredIPI[acpu->cpu_id] |= BIT32(dst_cpu_id);
+        apple_a13_ipi_timer_arm();
         break;
     case IPI_RR_TYPE_RETRACT:
         c->deferredIPI[acpu->cpu_id] &= ~BIT32(dst_cpu_id);
@@ -434,6 +480,7 @@ static void apple_a13_ipi_rr_global(CPUARMState *env, const ARMCPRegInfo *ri,
     case IPI_RR_TYPE_NOWAKE:
         if (apple_a13_is_asleep(dst_acpu)) {
             cluster->noWakeIPI[acpu->cpu_id] |= BIT32(dst_cpu_id);
+            apple_a13_ipi_timer_arm();
         } else {
             apple_a13_deliver_ipi(dst_acpu, acpu->cpu_id,
                                   IPI_RR_TYPE_IMMEDIATE);
@@ -441,6 +488,7 @@ static void apple_a13_ipi_rr_global(CPUARMState *env, const ARMCPRegInfo *ri,
         break;
     case IPI_RR_TYPE_DEFERRED:
         cluster->deferredIPI[acpu->cpu_id] |= BIT32(dst_cpu_id);
+        apple_a13_ipi_timer_arm();
         break;
     case IPI_RR_TYPE_RETRACT:
         cluster->deferredIPI[acpu->cpu_id] &= ~BIT32(dst_cpu_id);
@@ -510,7 +558,7 @@ static void apple_a13_ipi_write_cr(CPUARMState *env, const ARMCPRegInfo *ri,
 
     if (nanosec == 0) {
         timer_del(ipicr_timer);
-    } else {
+    } else if (apple_a13_ipi_timer_always() || apple_a13_ipi_pending()) {
         timer_mod_ns(ipicr_timer, ct + nanosec);
     }
     ipi_cr = nanosec;
