+/*
+ * QEMU_MCA_CAPTURE: each block of the ring taken at the moment the guest
+ * writes it, played in ring order.
+ *
+ * The guest's audio engine writes a block shortly before it thinks the
+ * hardware plays it and clears it with zeros shortly after. Emulated, its
+ * timing wanders, so a block read at a fixed moment (when consumed, or a
+ * fixed delay later) was often not yet written or already cleared: a cut.
+ * Here every consumed block waits in the queue and is looked at on each
+ * audio tick; the first time it holds sound that differs from what this
+ * block held when last taken, that sound is copied. The queue plays in
+ * order; a block still not written after QEMU_MCA_CAPTURE_MS (40 by
+ * default) is left out, with the crossfade.
+ */
+static void apple_mca_capture(AppleMCAState *s, int64_t now)
+{
+    static int64_t max_wait = -1;
+    static uint64_t st_cap, st_skip;
+    static int64_t st_last;
+
+    if (max_wait < 0) {
+        const char *v = getenv("QEMU_MCA_CAPTURE_MS");
+        max_wait = (v && atoi(v) > 0 ? atoi(v) : 40) * SCALE_MS;
+    }
+    for (uint32_t k = 0; k < s->pend_n; k++) {
+        typeof(s->pend[0]) *p = &s->pend[(s->pend_head + k) % ARRAY_SIZE(s->pend)];
+        if (p->cap || p->host == NULL) {
+            continue;
+        }
+        if (buffer_is_zero(p->host, p->len)) {
+            continue;
+        }
+        uint64_t hash = 0xcbf29ce484222325ULL;
+        for (uint32_t i = 0; i < p->len; ++i) {
+            hash = (hash ^ p->host[i]) * 0x100000001b3ULL;
+        }
+        hash ^= p->len | (p->addr % MCA_BLOCK) << 16;
+        MCABlock *b = apple_mca_block(s, p->addr);
+        if (b->hash == hash) {
+            continue;           /* what it held last time: not written yet */
+        }
+        memcpy(p->snap, p->host, p->len);
+        b->hash = hash;
+        p->cap = true;
+    }
+    while (s->pend_n) {
+        typeof(s->pend[0]) *p = &s->pend[s->pend_head];
+        if (p->cap) {
+            uint32_t n = p->len - s->pend_off;
+            uint32_t written = apple_mca_play(s, p->snap + s->pend_off, n);
+            s->pend_off += written;
+            if (written < n) {
+                break;          /* the host's buffer is full: the rest later */
+            }
+            st_cap++;
+        } else if (now - p->t > max_wait) {
+            s->splice = true;
+            st_skip++;
+        } else {
+            break;
+        }
+        s->pend_off = 0;
+        s->pend_head = (s->pend_head + 1) % ARRAY_SIZE(s->pend);
+        s->pend_n--;
+    }
+    if (getenv("QEMU_MCA_DEBUG") && now - st_last > NANOSECONDS_PER_SECOND) {
+        st_last = now;
+        fprintf(stderr, "mca: capture played %" PRIu64 " skipped %" PRIu64
+                " pending %u\n", st_cap, st_skip, s->pend_n);
     }
 }
 
