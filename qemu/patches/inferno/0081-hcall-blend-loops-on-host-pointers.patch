+/*
+ * Host pointer for the pixels from guest address a: how many 4-byte pixels
+ * (at most n) lie in its page, or 0 when that page is not plain RAM (then the
+ * caller does one pixel through ca_ld32/ca_st32).
+ */
+static inline uint32_t *ca_span(CPUARMState *env, CaCache *c, uint64_t a,
+                                uint64_t n, MMUAccessType type, int mmu,
+                                uintptr_t ra, uint64_t *got)
+{
+    uint64_t room = (TARGET_PAGE_SIZE - (a & ~TARGET_PAGE_MASK)) / 4;
+    uint8_t *h = (a & 3) ? NULL : ca_cache_find(env, c, a, type, mmu, ra);
+
+    *got = h ? MIN(n, room) : 0;
+    return (uint32_t *)h;
+}
+
+/* One row of the vImage blend: pixels below vec with its NEON formula, the rest scalar. */
+static void ca_blend_row(CPUARMState *env, CaCache *tc, CaCache *bc, CaCache *dc,
+                         uint64_t top, uint64_t back, uint64_t dst, uint64_t width,
+                         uint64_t vec, int mmu, uintptr_t ra)
+{
+    uint64_t i = 0;
+
+    while (i < width) {
+        uint64_t nt, nb, nd;
+        uint32_t *ht = ca_span(env, tc, top + 4 * i, width - i, MMU_DATA_LOAD, mmu, ra, &nt);
+        uint32_t *hb = ca_span(env, bc, back + 4 * i, width - i, MMU_DATA_LOAD, mmu, ra, &nb);
+        uint32_t *hd = ca_span(env, dc, dst + 4 * i, width - i, MMU_DATA_STORE, mmu, ra, &nd);
+        uint64_t n = MIN(nt, MIN(nb, nd));
+
+        if (!n) {
+            uint32_t t = ca_ld32(env, tc, top + 4 * i, mmu, ra);
+            uint32_t b = ca_ld32(env, bc, back + 4 * i, mmu, ra);
+            ca_st32(env, dc, dst + 4 * i,
+                    i < vec ? vimage_blend_vec(t, b) : vimage_blend_scalar(t, b),
+                    mmu, ra);
+            i++;
+            continue;
+        }
+        for (uint64_t j = 0; j < n; j++, i++) {
+            uint32_t t = ldl_le_p(&ht[j]), b = ldl_le_p(&hb[j]);
+            stl_le_p(&hd[j], i < vec ? vimage_blend_vec(t, b) : vimage_blend_scalar(t, b));
+        }
+    }
+}
