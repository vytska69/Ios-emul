+static inline uint32_t ca_unpremultiply_px(uint32_t p, float k, float eps)
+{
+    float a = (float)(p >> 24) * k;
+    float r = (float)((p >> 16) & 0xff) * k;
+    float g = (float)((p >> 8) & 0xff) * k;
+    float b = (float)(p & 0xff) * k;
+    float inv;
+
+    if (!(a >= eps)) {
+        a = eps;                /* fmaxnm(a, eps); a is never NaN */
+    }
+    inv = 1.0f / a;
+    r = r * 255.0f;
+    g = g * 255.0f;
+    b = b * 255.0f;
+    return 0xff000000u | ca_clamp255s(ca_fcvtzu32(inv * r)) << 16 |
+           ca_clamp255s(ca_fcvtzu32(inv * g)) << 8 |
+           ca_clamp255s(ca_fcvtzu32(inv * b));
+}
