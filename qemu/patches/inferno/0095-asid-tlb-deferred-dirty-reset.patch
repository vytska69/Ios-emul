             asid_tlb_restore(back, d, f);
@@ -1428,20 +1528,8 @@ void tlb_reset_dirty(CPUState *cpu, uintptr_t start, uintptr_t length)
         }
 
         ASIDTLB *a = asid_tlb_of(cpu, mmu_idx);
-        for (int k = 0; a && k < ASID_TLB_SLOTS; k++) {
-            ASIDTLBSlot *s = &a->slot[k];
-            if (!s->valid) {
-                continue;
-            }
-            n = (s->mask >> CPU_TLB_ENTRY_BITS) + 1;
-            for (i = 0; i < n; i++) {
-                tlb_reset_dirty_range_locked(&s->fulltlb[i], &s->table[i],
-                                             start, length);
-            }
-            for (i = 0; i < CPU_VTLB_SIZE; i++) {
-                tlb_reset_dirty_range_locked(&s->vfulltlb[i], &s->vtable[i],
-                                             start, length);
-            }
+        if (a) {
+            asid_tlb_log_dirty(a, start, length);
         }
     }
     qemu_spin_unlock(&cpu->neg.tlb.c.lock);
