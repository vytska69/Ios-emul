@@ -152,6 +152,8 @@ struct AppleMCAState {
     AppleSIODMAEndpoint *rx_ep;
     QEMUSoundCard card;
     SWVoiceOut *voice;
+    /* Bytes of silence held back (apple_mca_play). */
