+/*
+ * Plays the guest's output, leaving out short runs of silence. Emulated, the
+ * guest's audio often misses its deadline, and the parts of its ring it had no
+ * sound for in time are silent: playing them cut every sound into pieces a few
+ * milliseconds apart, with a click at each cut. A run of exactly silent frames
+ * is left out until the silence has lasted 40 ms; silence that lasts longer (a
+ * pause between words, the end of a sound) is still played. Returns the bytes
+ * the voice took, counting the left-out silence as taken.
+ */
+#define MCA_FRAME 4                                       /* stereo S16 */
+#define MCA_SILENCE_KEPT (48000 * MCA_FRAME * 40 / 1000)  /* 40 ms */
+
+static bool apple_mca_frame_silent(const uint8_t *frame)
+{
+    return !(frame[0] | frame[1] | frame[2] | frame[3]);
+}
+
+static uint32_t apple_mca_play(AppleMCAState *s, uint8_t *data, uint32_t len)
+{
+    uint32_t done = 0;
+
+    len -= len % MCA_FRAME;
+    while (done < len) {
+        /* Sound up to the next silent frame, or held-back silence past 40 ms. */
+        uint32_t end = done;
+        while (end < len && (!apple_mca_frame_silent(data + end) ||
+                             s->held_silence >= MCA_SILENCE_KEPT)) {
+            if (!apple_mca_frame_silent(data + end)) {
+                s->held_silence = 0;
+            }
+            end += MCA_FRAME;
+        }
+        if (end > done) {
+            uint32_t n = end - done;
+            uint32_t written = AUD_write(s->voice, data + done, n);
+            done += written;
+            if (written < n) {
+                return done;
+            }
+        }
+        /* Silent frames, left out while the silence is short. */
+        while (done < len && apple_mca_frame_silent(data + done) &&
+               s->held_silence < MCA_SILENCE_KEPT) {
+            s->held_silence += MCA_FRAME;
+            done += MCA_FRAME;
+        }
+    }
+    return done;
+}
+
