+        if (consumed == 0) {
             /*
              * The guest has nothing queued (emulated, it often falls behind real
              * time). The capture endpoint still gets silence at the real rate, as
@@ -403,12 +457,15 @@ static void apple_mca_out_callback(void *opaque, int avail)
         /*
          * Feed the output back to the capture endpoint when the guest has one
          * running (echo reference), but play it either way: the host hears
-         * what the guest sends, not only what it also records.
+         * what the guest sends, not only what it also records. Ring contents
+         * the guest had not refilled (apple_sio_dma_read_fresh) are left out,
+         * so the host hears no old sound twice.
          */
-        apple_sio_dma_write(s->rx_ep, temp, pulled);
-        uint32_t written = AUD_write(s->voice, temp, pulled);
+        memset(temp + pulled, 0, consumed - pulled);
+        apple_sio_dma_write(s->rx_ep, temp, consumed);
