diff --git a/include/qemu/timer.h b/include/qemu/timer.h
index fd6972b..45cb716 100644
--- a/include/qemu/timer.h
+++ b/include/qemu/timer.h
@@ -831,9 +831,26 @@ static inline int64_t get_clock(void)
 
 #elif defined(__APPLE__)
 
+/* From <mach/mach_time.h>, not included here: it brings all of Mach's types. */
+uint64_t mach_continuous_time(void);
+
+/* mach_timebase_info, read once (util/qemu-timer-common.c); 0 until then. */
+extern uint32_t qemu_mach_numer, qemu_mach_denom;
+
 static inline int64_t get_clock(void)
 {
-    /* Equivalent to `mach_continuous_time()` */
+    /*
+     * CLOCK_MONOTONIC_RAW is mach_continuous_time() in nanoseconds, but
+     * clock_gettime_nsec_np queried the timebase on every call; the guest
+     * reads its counter (and so this) very often.
+     */
+    if (likely(qemu_mach_denom)) {
+        uint64_t t = mach_continuous_time();
+        if (likely(t < UINT64_MAX / 1000)) {
+            return t * qemu_mach_numer / qemu_mach_denom;
+        }
+        return muldiv64(t, qemu_mach_numer, qemu_mach_denom);
+    }
     return clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
 }
 
diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index d434a4d..123da72 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -1098,8 +1098,20 @@ unsigned int gt_cntfrq_period_ns(ARMCPU *cpu)
      * Finally, CNTFRQ is effectively capped at 1GHz to ensure our scale factor
      * cannot become zero.
      */
-    return NANOSECONDS_PER_SECOND > cpu->gt_cntfrq_hz ?
+    /* The last frequency and its period, packed (read on every counter access). */
+    static uint64_t last;
+    uint64_t l = qatomic_read(&last);
+    uint32_t period;
+
+    if (likely(l && (l >> 32) == cpu->gt_cntfrq_hz)) {
+        return (uint32_t)l;
+    }
+    period = NANOSECONDS_PER_SECOND > cpu->gt_cntfrq_hz ?
       NANOSECONDS_PER_SECOND / cpu->gt_cntfrq_hz : 1;
+    if (cpu->gt_cntfrq_hz <= UINT32_MAX) {
+        qatomic_set(&last, (uint64_t)cpu->gt_cntfrq_hz << 32 | period);
+    }
+    return period;
 }
 
 static void arm_cpu_propagate_feature_implications(ARMCPU *cpu)
diff --git a/util/qemu-timer-common.c b/util/qemu-timer-common.c
index 28803f2..f71dc0f 100644
--- a/util/qemu-timer-common.c
+++ b/util/qemu-timer-common.c
@@ -48,8 +48,19 @@ static void __attribute__((constructor)) init_get_clock(void)
 
 #elif defined(__APPLE__)
 
+#include <mach/mach_time.h>
+
+uint32_t qemu_mach_numer, qemu_mach_denom;
+
 static void __attribute__((constructor)) init_get_clock(void)
 {
+    mach_timebase_info_data_t tb;
+
+    /* numer up to 1000 keeps t * numer in 64 bits for any sane uptime. */
+    if (mach_timebase_info(&tb) == 0 && tb.denom && tb.numer <= 1000) {
+        qemu_mach_numer = tb.numer;
+        qemu_mach_denom = tb.denom;
+    }
     clock_start = get_clock();
 }
 
