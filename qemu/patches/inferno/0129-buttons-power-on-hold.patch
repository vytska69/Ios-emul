+static int64_t apple_buttons_boot_hold_ms(void)
+{
+    const char *v = getenv("QEMU_BUTTONS_BOOT_HOLD_MS");
+    return v ? atoll(v) : 3000;
+}
+
+/* The power-on press ends: tell iOS the hold button went up. */
+static void apple_buttons_hold_release(void *opaque)
+{
+    AppleButtonsState *s = opaque;
+    AppleSMCState *smc = APPLE_SMC_IOP(object_property_get_link(
+        OBJECT(qdev_get_machine()), "smc", &error_fatal));
+
+    QEMU_LOCK_GUARD(&s->mutex);
+    if (!s->hold_boot) {
+        return;
+    }
+    s->hold_boot = false;
+    if (apple_buttons_smc_log()) {
+        fprintf(stderr, "buttons: power-on hold released\n");
+    }
+    apple_smc_send_hid_button(smc, SMC_HID_BUTTON_HOLD, false);
+}
+
 #define BUTTON_READER(_btn, _op, _enum)                                   \
     static SMCResult apple_buttons_smc_read_##_btn(                       \
         SMCKey *key, SMCKeyData *data, const void *in, uint8_t in_length) \
@@ -151,9 +185,18 @@ static bool apple_buttons_smc_log(void)
         bool push = SMC_HID_BUTTON_##_enum != SMC_HID_BUTTON_RINGER;      \
         bool hold = SMC_HID_BUTTON_##_enum == SMC_HID_BUTTON_HOLD;        \
         if (m == 1 || (m == 2 && push) || (m == 3 && push && !hold) ||    \
-            (m == 4 && push && !(hold && !s->hold_seen))) {               \
+            (m == 4 && push && !(hold && !s->hold_seen)) ||               \
+            (m == 5 && push)) {                                           \
             v = !v;                                                       \
         }                                                                 \
+        if (m == 5 && hold && s->hold_boot) {                             \
+            v = 1;                                                        \
+            if (!timer_pending(s->hold_release)) {                        \
+                timer_mod(s->hold_release,                                \
+                          qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +         \
+                              apple_buttons_boot_hold_ms());              \
+            }                                                             \
+        }                                                                 \
         if (apple_buttons_smc_log()) {                                    \
             fprintf(stderr, "buttons: read %s -> %d\n", #_btn, v);        \
         }                                                                 \
@@ -192,6 +235,9 @@ SysBusDevice *apple_buttons_create(AppleDTNode *node)
                       &powered_by_hold_btn);
 
     qemu_mutex_init(&s->mutex);
+    s->hold_boot = true;
+    s->hold_release =
+        timer_new_ms(QEMU_CLOCK_VIRTUAL, apple_buttons_hold_release, s);
 
     return sbd;
 }
@@ -202,6 +248,8 @@ static void apple_buttons_qdev_reset_hold(Object *obj, ResetType type)
     QEMU_LOCK_GUARD(&s->mutex);
     s->states = 0;
     s->hold_seen = false;
+    s->hold_boot = true;
+    timer_del(s->hold_release);
 }
 
