 }
 
+/* A page or range flush of @midx applied to its kept TLBs. */
+static void asid_tlb_flush_range(CPUState *cpu, int midx, vaddr addr,
+                                 vaddr len, vaddr mask)
+{
+    ASIDTLB *a = asid_tlb_of(cpu, midx);
+
+    if (!a) {
+        return;
+    }
+    for (int i = 0; i < ASID_TLB_SLOTS; i++) {
+        ASIDTLBSlot *s = &a->slot[i];
+        uintptr_t size_mask = s->mask >> CPU_TLB_ENTRY_BITS;
+
+        if (!s->valid) {
+            continue;
+        }
+        if (mask < s->mask || (len > TARGET_PAGE_SIZE && len > s->mask) ||
+            ((addr + len - 1) & s->large_page_mask) == s->large_page_addr ||
+            (addr & s->large_page_mask) == s->large_page_addr) {
+            asid_tlb_slot_free(s);
+            continue;
+        }
+        for (vaddr o = 0; o < len; o += TARGET_PAGE_SIZE) {
+            vaddr page = addr + o;
+            CPUTLBEntry *e = &s->table[(page >> TARGET_PAGE_BITS) & size_mask];
+
+            if (tlb_flush_entry_mask_locked(e, page, mask) && s->n_used_entries) {
+                s->n_used_entries--;
+            }
+            for (int k = 0; k < CPU_VTLB_SIZE; k++) {
+                tlb_flush_entry_mask_locked(&s->vtable[k], page, mask);
+            }
+        }
+    }
+}
