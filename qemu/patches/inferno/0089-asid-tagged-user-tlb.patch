+/*
+ * Per-address-space TLBs for the user's mmu_idx (QEMU_ASID_TLB=1): a switch of
+ * TTBR0 (tlb_switch_lower_half) used to flush that TLB, so every return to a
+ * process walked its page tables again for each page it touched. Instead the
+ * TLB is put aside under the old address space's tag and the new one's, if
+ * kept, comes back. The kept TLBs see every invalidation the live one does:
+ * a full flush of the mmu_idx (any TLBI by ASID, VMALLE1, ...) drops them, a
+ * page or range flush is applied to each, and tlb_reset_dirty marks them too.
+ * All of it under tlb_c.lock.
+ */
+#define ASID_TLB_SLOTS 8
+#define ASID_TLB_MAX_CPUS 32
+
+typedef struct ASIDTLBSlot {
+    bool valid;
+    uint64_t tag;
+    uint64_t lru;
+    uintptr_t mask;
+    CPUTLBEntry *table;
+    CPUTLBEntryFull *fulltlb;
+    size_t n_used_entries;
+    vaddr large_page_addr;
+    vaddr large_page_mask;
+    size_t vindex;
+    CPUTLBEntry vtable[CPU_VTLB_SIZE];
+    CPUTLBEntryFull vfulltlb[CPU_VTLB_SIZE];
+} ASIDTLBSlot;
+
+typedef struct ASIDTLB {
+    int midx;
+    bool cur_known;
+    uint64_t cur_tag;
+    uint64_t clock;
+    ASIDTLBSlot slot[ASID_TLB_SLOTS];
+} ASIDTLB;
+
+static ASIDTLB *asid_tlbs[ASID_TLB_MAX_CPUS];
+
+static bool asid_tlb_enabled(void)
+{
+    static int on = -1;
+    if (unlikely(on < 0)) {
+        const char *v = getenv("QEMU_ASID_TLB");
+        on = v && v[0] == '1';
+    }
+    return on;
+}
+
+/* This CPU's kept TLBs for @midx, or NULL. */
+static inline ASIDTLB *asid_tlb_of(CPUState *cpu, int midx)
+{
+    ASIDTLB *a = cpu->cpu_index < ASID_TLB_MAX_CPUS ?
+                 asid_tlbs[cpu->cpu_index] : NULL;
+    return a && a->midx == midx ? a : NULL;
+}
+
+static void asid_tlb_slot_free(ASIDTLBSlot *s)
+{
+    g_free(s->table);
+    g_free(s->fulltlb);
+    s->table = NULL;
+    s->fulltlb = NULL;
+    s->valid = false;
+}
+
+static void asid_tlb_drop(CPUState *cpu, int midx)
+{
+    ASIDTLB *a = asid_tlb_of(cpu, midx);
+
+    if (a) {
+        for (int i = 0; i < ASID_TLB_SLOTS; i++) {
+            if (a->slot[i].valid) {
+                asid_tlb_slot_free(&a->slot[i]);
+            }
+        }
+    }
+}
+
+static void asid_tlb_drop_map(CPUState *cpu, MMUIdxMap map)
+{
+    int c = cpu->cpu_index;
+    ASIDTLB *a = c < ASID_TLB_MAX_CPUS ? asid_tlbs[c] : NULL;
+
+    if (a && (map >> a->midx) & 1) {
+        asid_tlb_drop(cpu, a->midx);
+    }
+}
+
 static void tlb_flush_one_mmuidx_locked(CPUState *cpu, int mmu_idx,
                                         int64_t now)
 {
     CPUTLBDesc *desc = &cpu->neg.tlb.d[mmu_idx];
     CPUTLBDescFast *fast = cpu_tlb_fast(cpu, mmu_idx);
 
+    asid_tlb_drop(cpu, mmu_idx);
+
     tlb_mmu_resize_locked(desc, fast, now);
     tlb_mmu_flush_locked(desc, fast);
 }
