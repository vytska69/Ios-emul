@@ -560,12 +652,115 @@ void tlb_flush_lower_half(CPUState *cpu, MMUIdxMap fullmap, MMUIdxMap halfmap)
     }
 }
 
+static void asid_tlb_save(ASIDTLBSlot *s, CPUTLBDesc *d, CPUTLBDescFast *f,
+                          uint64_t tag, uint64_t lru)
+{
+    s->valid = true;
+    s->tag = tag;
+    s->lru = lru;
+    s->mask = f->mask;
+    s->table = f->table;
+    s->fulltlb = d->fulltlb;
+    s->n_used_entries = d->n_used_entries;
+    s->large_page_addr = d->large_page_addr;
+    s->large_page_mask = d->large_page_mask;
+    s->vindex = d->vindex;
+    memcpy(s->vtable, d->vtable, sizeof(s->vtable));
+    memcpy(s->vfulltlb, d->vfulltlb, sizeof(s->vfulltlb));
+}
+
+static void asid_tlb_restore(ASIDTLBSlot *s, CPUTLBDesc *d, CPUTLBDescFast *f)
+{
+    f->mask = s->mask;
+    f->table = s->table;
+    d->fulltlb = s->fulltlb;
+    d->n_used_entries = s->n_used_entries;
+    d->large_page_addr = s->large_page_addr;
+    d->large_page_mask = s->large_page_mask;
+    d->vindex = s->vindex;
+    memcpy(d->vtable, s->vtable, sizeof(d->vtable));
+    memcpy(d->vfulltlb, s->vfulltlb, sizeof(d->vfulltlb));
+    s->table = NULL;
+    s->fulltlb = NULL;
+    s->valid = false;
+}
+
+/* Called with tlb_c.lock held: the TLB of @midx becomes that of @tag. */
+static void asid_tlb_switch(CPUState *cpu, int midx, uint64_t tag)
+{
+    int c = cpu->cpu_index;
+    ASIDTLB *a = asid_tlbs[c];
+    CPUTLBDesc *d = &cpu->neg.tlb.d[midx];
+    CPUTLBDescFast *f = cpu_tlb_fast(cpu, midx);
+    ASIDTLBSlot *keep = NULL, *back = NULL;
+
+    if (!a) {
+        a = asid_tlbs[c] = g_new0(ASIDTLB, 1);
+        a->midx = midx;
+    }
+    if (a->cur_known && a->cur_tag == tag) {
+        return;
+    }
+    for (int i = 0; i < ASID_TLB_SLOTS; i++) {
+        if (a->slot[i].valid && a->slot[i].tag == tag) {
+            back = &a->slot[i];
+        }
+    }
+    if (a->cur_known && d->n_used_entries) {
+        /* A slot for the current TLB: a free one, else the least recent. */
+        for (int i = 0; i < ASID_TLB_SLOTS; i++) {
+            ASIDTLBSlot *s = &a->slot[i];
+            if (s == back) {
+                continue;
+            }
+            if (!s->valid) {
+                keep = s;
+                break;
+            }
+            if (!keep || s->lru < keep->lru) {
+                keep = s;
+            }
+        }
+        if (keep->valid) {
+            asid_tlb_slot_free(keep);
+        }
+        size_t n = tlb_n_entries(f);
+        asid_tlb_save(keep, d, f, a->cur_tag, ++a->clock);
+        if (back) {
+            asid_tlb_restore(back, d, f);
+        } else {
+            f->table = g_new(CPUTLBEntry, n);
+            d->fulltlb = g_new(CPUTLBEntryFull, n);
+            tlb_mmu_flush_locked(d, f);
+        }
+    } else if (back) {
+        g_free(f->table);
+        g_free(d->fulltlb);
+        asid_tlb_restore(back, d, f);
+    } else {
+        tlb_mmu_flush_locked(d, f);
+    }
+    a->cur_known = true;
+    a->cur_tag = tag;
+    cpu->neg.tlb.c.dirty |= 1 << midx;
+}
+
 void tlb_switch_lower_half(CPUState *cpu, MMUIdxMap fullmap, MMUIdxMap halfmap,
                            uint64_t tag)
 {
     CPUJumpCache *jc = cpu->tb_jmp_cache;
 
-    tlb_flush_lower_half_tlb(cpu, fullmap, halfmap);
+    if (asid_tlb_enabled() && ctpop32(fullmap) == 1 &&
+        cpu->cpu_index < ASID_TLB_MAX_CPUS &&
+        (!asid_tlbs[cpu->cpu_index] ||
+         asid_tlbs[cpu->cpu_index]->midx == ctz32(fullmap))) {
+        qemu_spin_lock(&cpu->neg.tlb.c.lock);
+        asid_tlb_switch(cpu, ctz32(fullmap), tag);
+        qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+        tlb_flush_lower_half_tlb(cpu, 0, halfmap);
+    } else {
+        tlb_flush_lower_half_tlb(cpu, fullmap, halfmap);
+    }
     if (jc) {
         jc->user_tag = tag;
     }
@@ -683,11 +878,49 @@ static inline void tlb_flush_vtlb_page_locked(CPUState *cpu, int mmu_idx,
