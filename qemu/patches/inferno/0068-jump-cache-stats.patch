diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 87f0de9..6461505 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -211,6 +211,55 @@ static TranslationBlock *tb_htable_lookup(CPUState *cpu, TCGTBCPUState s)
  *
  * Returns: an existing translation block or NULL.
  */
+/*
+ * QEMU_JC_STATS=1: classifies each lookup before it is made and prints the
+ * counts of this CPU every 2^24 lookups: 0 lookups, 1 hit, 2 hit in the other
+ * way, 3 same pc but another address space or generation, 4 same pc and
+ * address space but other flags, 5 no entry for the pc, 6 kernel (upper half)
+ * lookups, 7 kernel misses, 8 from helper_lookup_tb_ptr, 9 full flushes,
+ * 10 user-half generations, 11 page clears.
+ */
+static void tb_jmp_cache_count(CPUState *cpu, CPUJumpCache *jc, uint32_t hash,
+                               TCGTBCPUState s)
+{
+    int cls = 5;
+
+    for (int w = 0; w < 2; w++) {
+        uint32_t h = w ? hash ^ 1 : hash;
+        TranslationBlock *tb = qatomic_read(&jc->array[h].tb);
+
+        if (!tb || jc->array[h].pc != s.pc) {
+            continue;
+        }
+        if (!tb_jmp_cache_gen_ok(jc, h, s.pc)) {
+            cls = MIN(cls, 3);
+            continue;
+        }
+        if (tb->cs_base != s.cs_base || tb->flags != s.flags ||
+            tb_cflags(tb) != s.cflags) {
+            cls = MIN(cls, 4);
+            continue;
+        }
+        cls = w ? 2 : 1;
+        break;
+    }
+    jc->stats[0]++;
+    jc->stats[cls]++;
+    if ((int64_t)s.pc < 0) {
+        jc->stats[6]++;
+        if (cls > 2) {
+            jc->stats[7]++;
+        }
+    }
+    if ((jc->stats[0] & ((1u << 24) - 1)) == 0) {
+        fprintf(stderr, "jc-stats cpu%d", cpu->cpu_index);
+        for (int i = 0; i < 12; i++) {
+            fprintf(stderr, " %" PRIu64, jc->stats[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
