diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
index ef8ba8f..749def6 100644
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -42,6 +42,12 @@ typedef struct CPUJumpCache {
      * invalidation of the user half (TLBI ASIDE1 and the like) bumps user_gen.
      */
     uint64_t user_tag;
+    /*
+     * Entries for upper-half PCs are valid only while their gen equals
+     * all_gen: a full flush bumps all_gen and user_gen instead of clearing
+     * every entry.
+     */
+    uint64_t all_gen;
     /* QEMU_JC_STATS=1: lookup counters, printed to stderr (see tb_lookup). */
     uint64_t stats[12];
     struct {
@@ -55,8 +61,16 @@ typedef struct CPUJumpCache {
 static inline bool tb_jmp_cache_gen_ok(CPUJumpCache *jc, uint32_t hash,
                                        vaddr pc)
 {
-    return (int64_t)pc < 0 ||
-           (jc->array[hash].gen == jc->user_gen && jc->array[hash].tag == jc->user_tag);
+    if ((int64_t)pc < 0) {
+        return jc->array[hash].gen == jc->all_gen;
+    }
+    return jc->array[hash].gen == jc->user_gen && jc->array[hash].tag == jc->user_tag;
+}
+
+/* The generation an entry for @pc is stored with. */
+static inline uint64_t tb_jmp_cache_gen(CPUJumpCache *jc, vaddr pc)
+{
+    return (int64_t)pc < 0 ? jc->all_gen : jc->user_gen;
 }
 
 #endif /* ACCEL_TCG_TB_JMP_CACHE_H */
