--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -617,7 +617,10 @@ void tcg_flush_jmp_cache(CPUState *cpu)
     }
 
     jc->stats[9]++;
-    for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
-        qatomic_set(&jc->array[i].tb, NULL);
-    }
+    /*
+     * O(1): every entry was stored with the generation of its half, which
