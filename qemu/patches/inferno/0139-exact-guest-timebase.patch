diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index 123da72..5389381 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -1114,6 +1114,53 @@ unsigned int gt_cntfrq_period_ns(ARMCPU *cpu)
     return period;
 }
 
+/*
+ * The counter as the guest's frequency gives it: ticks = ns * hz / 1e9.
+ * The period above is a whole number of nanoseconds (41 for 24 MHz, not
+ * 41.67), so the guest's clock ran 1.6% fast: the guest's sound hardware,
+ * timed by the real clock, then fell behind what the guest expected and its
+ * audio skipped parts of its buffer. Timers are set in nanoseconds rounded
+ * up, so a timer never fires before the counter reaches its tick.
+ * QEMU_GT_TRUNC=1: the old whole-nanosecond period.
+ */
+bool gt_exact(void)
+{
+    static int exact = -1;
+
+    if (exact < 0) {
+        const char *v = getenv("QEMU_GT_TRUNC");
+        exact = !(v && v[0] == '1');
+    }
+    return exact;
+}
+
+uint64_t gt_ns_to_ticks(ARMCPU *cpu, uint64_t ns)
+{
+    if (!gt_exact() || cpu->gt_cntfrq_hz > UINT32_MAX) {
+        return ns / gt_cntfrq_period_ns(cpu);
+    }
+    return muldiv64(ns, cpu->gt_cntfrq_hz, NANOSECONDS_PER_SECOND);
+}
+
+void gt_timer_mod_ticks(ARMCPU *cpu, QEMUTimer *timer, uint64_t ticks)
+{
+    if (!gt_exact() || cpu->gt_cntfrq_hz > UINT32_MAX) {
+        if (ticks > INT64_MAX / gt_cntfrq_period_ns(cpu)) {
+            timer_mod_ns(timer, INT64_MAX);
+        } else {
+            timer_mod(timer, ticks);
+        }
+        return;
+    }
+    if (ticks >= muldiv64(INT64_MAX, cpu->gt_cntfrq_hz,
+                          NANOSECONDS_PER_SECOND)) {
+        timer_mod_ns(timer, INT64_MAX);
+    } else {
+        timer_mod_ns(timer, muldiv64_round_up(ticks, NANOSECONDS_PER_SECOND,
+                                              cpu->gt_cntfrq_hz));
+    }
+}
+
