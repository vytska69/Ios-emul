+/* Bytes of one run, for -d guest_errors ("SPI-RUN:"), first runs only. */
+static unsigned apple_spi_log_runs;
+static GString *apple_spi_log_tx;
+static GString *apple_spi_log_rx;
+
+static void apple_spi_log_byte(GString *s, uint8_t b)
+{
+    if (s->len < 3 * 48) {
+        g_string_append_printf(s, "%02x", b);
+    }
+}
+
+static void apple_spi_run_logged(AppleSPIState *spi);
+
 static void apple_spi_run(AppleSPIState *spi)
+{
+    bool log = apple_spi_log_runs < 3000 &&
+               qemu_loglevel_mask(LOG_GUEST_ERROR);
+    uint32_t txcnt = REG(spi, REG_TXCNT);
+    uint32_t rxcnt = REG(spi, REG_RXCNT);
+
+    if (log) {
+        if (!apple_spi_log_tx) {
+            apple_spi_log_tx = g_string_new(NULL);
+            apple_spi_log_rx = g_string_new(NULL);
+        }
+        g_string_truncate(apple_spi_log_tx, 0);
+        g_string_truncate(apple_spi_log_rx, 0);
+    }
+    apple_spi_run_logged(spi);
+    if (log && (apple_spi_log_tx->len || apple_spi_log_rx->len)) {
+        apple_spi_log_runs++;
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "SPI-RUN: %s cfg 0x%x word %u txcnt %u rxcnt %u tx %s rx %s\n",
+                      object_get_canonical_path_component(OBJECT(spi)),
+                      REG(spi, REG_CFG), apple_spi_word_size(spi), txcnt,
+                      rxcnt, apple_spi_log_tx->str, apple_spi_log_rx->str);
+    }
+}
