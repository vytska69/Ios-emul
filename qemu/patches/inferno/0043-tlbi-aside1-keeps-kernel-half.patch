+/*
+ * TLBI ASIDE1{,IS,OS}: only the non-global entries of the ASID go, so a guest
+ * whose upper half is global (XNU's kernel) keeps those. QEMU does not tag its
+ * TLB with ASIDs, so the whole lower half goes (the TTBR0 user half); it was a
+ * full flush of every EL1&0 TLB on every CPU. QEMU_FULL_ASID_FLUSH=1: as before.
+ */
+static bool tlbi_full_asid_flush(void)
+{
+    static int full = -1;
+
+    if (full < 0) {
+        const char *v = getenv("QEMU_FULL_ASID_FLUSH");
+        full = v && v[0] == '1';
+    }
+    return full;
+}
+
+static void tlbi_aa64_aside1_common(CPUARMState *env, bool broadcast)
+{
+    CPUState *cs = env_cpu(env);
+    int mask = vae1_tlbmask(env);
+
+    if (!(mask & ARMMMUIdxBit_E10_1) || tlbi_full_asid_flush()) {
+        if (broadcast) {
+            tlb_flush_by_mmuidx_all_cpus_synced(cs, mask);
+        } else {
+            tlb_flush_by_mmuidx(cs, mask);
+        }
+        return;
+    }
+    if (broadcast) {
+        tlb_flush_lower_half_all_cpus_synced(cs, mask & ARMMMUIdxBit_E10_0,
+                                             mask & ~ARMMMUIdxBit_E10_0);
+    } else {
+        tlb_flush_lower_half(cs, mask & ARMMMUIdxBit_E10_0,
+                             mask & ~ARMMMUIdxBit_E10_0);
+    }
+}
+
+static void tlbi_aa64_aside1is_write(CPUARMState *env, const ARMCPRegInfo *ri,
+                                     uint64_t value)
+{
+    tlbi_aa64_aside1_common(env, true);
+}
+
+static void tlbi_aa64_aside1_write(CPUARMState *env, const ARMCPRegInfo *ri,
+                                   uint64_t value)
+{
+    tlbi_aa64_aside1_common(env, tlb_force_broadcast(env));
+}
