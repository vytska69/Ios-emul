+/* Sets the timer's output to @irqstate; the caller holds the BQL. */
+static void gt_set_irq(ARMCPU *cpu, int timeridx, int irqstate)
+{
+    cpu->gt_irq_level[timeridx] = irqstate;
     qemu_set_irq(cpu->gt_timer_outputs[timeridx], irqstate);
     trace_arm_gt_update_irq(timeridx, irqstate);
 }
 
+/*
+ * Without the BQL (a guest access to CNTP_* / CNTV_*): when the output
+ * already has @irqstate there is nothing more to do; otherwise take the BQL
+ * and set it from the state as it is then.
+ */
+static void gt_set_irq_unlocked(ARMCPU *cpu, int timeridx, int irqstate)
+{
+    if (qatomic_read(&cpu->gt_irq_level[timeridx]) == irqstate) {
+        return;
+    }
+    bql_lock();
+    qemu_mutex_lock(&cpu->gt_lock);
+    irqstate = gt_irq_state(cpu, timeridx);
+    qemu_mutex_unlock(&cpu->gt_lock);
+    gt_set_irq(cpu, timeridx, irqstate);
+    bql_unlock();
+}
+
+static void gt_update_irq(ARMCPU *cpu, int timeridx)
+{
+    int irqstate;
+
+    if (bql_locked()) {
+        qemu_mutex_lock(&cpu->gt_lock);
+        irqstate = gt_irq_state(cpu, timeridx);
+        qemu_mutex_unlock(&cpu->gt_lock);
+        gt_set_irq(cpu, timeridx, irqstate);
+    } else {
+        qemu_mutex_lock(&cpu->gt_lock);
+        irqstate = gt_irq_state(cpu, timeridx);
+        qemu_mutex_unlock(&cpu->gt_lock);
+        gt_set_irq_unlocked(cpu, timeridx, irqstate);
+    }
+}
