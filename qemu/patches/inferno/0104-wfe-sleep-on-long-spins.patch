diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
index cbf2abb..6bb5c9e 100644
--- a/target/arm/tcg/op_helper.c
+++ b/target/arm/tcg/op_helper.c
@@ -478,12 +478,48 @@ static bool arm_yield_in_place(void)
     return in_place;
 }
 
+/*
+ * A vCPU that has spun on the same WFE/YIELD for more than 30 us (a guest
+ * spinlock whose holder is not running: more vCPUs than free host cores)
+ * sleeps 20 us at each turn instead of only yielding, which on macOS gave the
+ * host CPU to no one and the spinner kept it from the lock's holder. Short
+ * waits, the usual case, are as before. QEMU_WFE_SLEEP=0: yield only.
+ */
+static void arm_spin_wait(CPUARMState *env)
+{
+    static int sleep_on = -1;
+    static __thread uint64_t last_pc;
+    static __thread int64_t since, last;
+    int64_t now;
+
+    if (sleep_on < 0) {
+        const char *v = getenv("QEMU_WFE_SLEEP");
+        sleep_on = !(v && v[0] == '0');
+    }
+    if (!sleep_on) {
+        g_thread_yield();
+        return;
+    }
+    now = get_clock();
+    if (env->pc != last_pc || now - last > 10000) {
+        last_pc = env->pc;
+        since = now;
+    }
+    last = now;
+    if (now - since > 30000) {
+        g_usleep(20);
+        last = get_clock();
+    } else {
+        g_thread_yield();
+    }
+}
+
 void HELPER(yield)(CPUARMState *env)
 {
     CPUState *cs = env_cpu(env);
 
     if (arm_yield_in_place()) {
-        g_thread_yield();
+        arm_spin_wait(env);
         return;
     }
 
