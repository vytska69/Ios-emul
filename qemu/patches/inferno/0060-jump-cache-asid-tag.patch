diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
index 0295ec7..d9590f8 100644
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -35,17 +35,26 @@ typedef struct CPUJumpCache {
      * user_gen; tlb_flush_lower_half bumps it instead of clearing them.
      */
     uint64_t user_gen;
+    /*
+     * And while their tag equals user_tag: the address space they were cached
+     * in (TTBR0). Switching to another address space changes user_tag only, so
+     * the entries of a process are still there when it runs again; a TLB
+     * invalidation of the user half (TLBI ASIDE1 and the like) bumps user_gen.
+     */
+    uint64_t user_tag;
     struct {
         TranslationBlock *tb;
         vaddr pc;
         uint64_t gen;
+        uint64_t tag;
     } array[TB_JMP_CACHE_SIZE];
 } CPUJumpCache;
 
 static inline bool tb_jmp_cache_gen_ok(CPUJumpCache *jc, uint32_t hash,
                                        vaddr pc)
 {
-    return (int64_t)pc < 0 || jc->array[hash].gen == jc->user_gen;
+    return (int64_t)pc < 0 ||
+           (jc->array[hash].gen == jc->user_gen && jc->array[hash].tag == jc->user_tag);
 }
 
 #endif /* ACCEL_TCG_TB_JMP_CACHE_H */
