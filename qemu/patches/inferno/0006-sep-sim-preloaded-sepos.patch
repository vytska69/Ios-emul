diff --git a/hw/arm/apple-silicon/sep-sim.c b/hw/arm/apple-silicon/sep-sim.c
index 5b4b7d1..f714d58 100644
--- a/hw/arm/apple-silicon/sep-sim.c
+++ b/hw/arm/apple-silicon/sep-sim.c
@@ -1147,7 +1147,11 @@ static void apple_sep_sim_reset_hold(Object *obj, ResetType type)
         }
     }
 
-    s->status = SEP_STATUS_BOOTSTRAP;
+    /*
+     * Without iBoot nothing loads the SEP firmware, so a direct boot starts with SEPOS already
+     * running: announce the active state, then what BOOT_IMG4 would have sent.
+     */
+    s->status = s->preloaded ? SEP_STATUS_ACTIVE : SEP_STATUS_BOOTSTRAP;
 
     msg = g_new0(AppleA7IOPMessage, 1);
     sep_msg = (SEPMessage *)msg->data;
@@ -1155,6 +1159,12 @@ static void apple_sep_sim_reset_hold(Object *obj, ResetType type)
     sep_msg->op = BOOTSTRAP_OP_ANNOUNCE_STATUS;
     sep_msg->data = s->status;
     apple_a7iop_send_ap(a7iop, msg);
+
+    if (s->preloaded) {
+        qemu_log_mask(LOG_GUEST_ERROR, "SEP-SIM: starting with SEPOS preloaded\n");
+        apple_sep_sim_send_message(s, EP_CONTROL, 0, CONTROL_OP_NOTIFY_ALIVE, 0, 0);
+        apple_sep_sim_advertise_eps(s);
+    }
 }
 
 static void apple_sep_sim_class_init(ObjectClass *klass, const void *data)
