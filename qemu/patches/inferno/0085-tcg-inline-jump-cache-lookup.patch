+void translator_lookup_and_goto_ptr(DisasContextBase *db, CPUState *cpu,
+                                    TCGv_i64 pc, uint32_t flags,
+                                    TCGv_i64 cs_base)
+{
+    static int enabled = -1;
+    uint32_t cflags = tb_cflags(db->tb);
+
+    if (unlikely(enabled < 0)) {
+        const char *v = getenv("QEMU_INLINE_LOOKUP");
+        enabled = v && v[0] == '1';
+    }
+#if TCG_TARGET_REG_BITS == 64 && !HOST_BIG_ENDIAN
+    if (enabled && !(cflags & CF_NO_GOTO_PTR) && cflags == curr_cflags(cpu)) {
+        /*
+         * The hit path of tb_lookup() for the first way of the jump cache,
+         * which is where nearly every hit is: the entry's tb is not NULL,
+         * its pc is @pc, its (gen, tag) is {user_gen, user_tag} for a lower
+         * half pc or {all_gen, kern_tag} for an upper half one, and the
+         * TB's cs_base, flags and cflags are what tb_lookup() would compare
+         * them with (an invalidated TB has CF_INVALID in its cflags).
+         * Anything else goes to the helper, as before.
+         */
+        QEMU_BUILD_BUG_ON(offsetof(CPUJumpCache, user_tag) !=
+                          offsetof(CPUJumpCache, user_gen) + 8);
+        QEMU_BUILD_BUG_ON(offsetof(CPUJumpCache, all_gen) !=
+                          offsetof(CPUJumpCache, user_gen) + 16);
+        QEMU_BUILD_BUG_ON(offsetof(CPUJumpCache, kern_tag) !=
+                          offsetof(CPUJumpCache, user_gen) + 24);
+        QEMU_BUILD_BUG_ON(sizeof(((CPUJumpCache *)0)->array[0]) != 32);
+        QEMU_BUILD_BUG_ON(offsetof(TranslationBlock, cflags) !=
+                          offsetof(TranslationBlock, flags) + 4);
+        QEMU_BUILD_BUG_ON(sizeof(vaddr) != 8);
+
+        int sh = TARGET_PAGE_BITS - TB_JMP_PAGE_BITS;
+        TCGLabel *miss = gen_new_label();
+        TCGv_i64 h = tcg_temp_new_i64(), t = tcg_temp_new_i64();
+        TCGv_i64 u = tcg_temp_new_i64();
+        TCGv_ptr jc = tcg_temp_new_ptr(), e = tcg_temp_new_ptr();
+        TCGv_ptr g = tcg_temp_new_ptr(), tb = tcg_temp_new_ptr();
+
+        /* e = &jc->array[tb_jmp_cache_hash_func(pc)] */
+        tcg_gen_shri_i64(t, pc, sh);
+        tcg_gen_xor_i64(t, t, pc);
+        tcg_gen_shri_i64(h, t, sh);
+        tcg_gen_andi_i64(h, h, TB_JMP_PAGE_MASK);
+        tcg_gen_andi_i64(t, t, TB_JMP_ADDR_MASK);
+        tcg_gen_or_i64(h, h, t);
+        tcg_gen_shli_i64(h, h, 5);
+        tcg_gen_ld_ptr(jc, tcg_env,
+                       offsetof(CPUState, tb_jmp_cache) - sizeof(CPUState));
+        tcg_gen_trunc_i64_ptr(e, h);
+        tcg_gen_add_ptr(e, e, jc);
+
+        tcg_gen_ld_i64(t, e, offsetof(CPUJumpCache, array[0].pc));
+        tcg_gen_brcond_i64(TCG_COND_NE, t, pc, miss);
+        tcg_gen_ld_ptr(tb, e, offsetof(CPUJumpCache, array[0].tb));
+        tcg_gen_brcondi_ptr(TCG_COND_EQ, tb, 0, miss);
+
+        /* g = &jc->user_gen + 16 * (pc >> 63) */
+        tcg_gen_shri_i64(h, pc, 63);
+        tcg_gen_shli_i64(h, h, 4);
+        tcg_gen_trunc_i64_ptr(g, h);
+        tcg_gen_add_ptr(g, g, jc);
+        tcg_gen_ld_i64(t, e, offsetof(CPUJumpCache, array[0].gen));
+        tcg_gen_ld_i64(u, g, offsetof(CPUJumpCache, user_gen));
+        tcg_gen_brcond_i64(TCG_COND_NE, t, u, miss);
+        tcg_gen_ld_i64(t, e, offsetof(CPUJumpCache, array[0].tag));
+        tcg_gen_ld_i64(u, g, offsetof(CPUJumpCache, user_tag));
+        tcg_gen_brcond_i64(TCG_COND_NE, t, u, miss);
+
+        tcg_gen_ld_i64(t, tb, offsetof(TranslationBlock, cs_base));
+        tcg_gen_brcond_i64(TCG_COND_NE, t, cs_base, miss);
+        tcg_gen_ld_i64(t, tb, offsetof(TranslationBlock, flags));
+        tcg_gen_brcondi_i64(TCG_COND_NE, t,
+                            flags | ((uint64_t)cflags << 32), miss);
+
+        tcg_gen_ld_ptr(tb, tb, offsetof(TranslationBlock, tc.ptr));
+        tcg_gen_goto_ptr(tb);
+
+        gen_set_label(miss);
+    }
+#endif
+    tcg_gen_lookup_and_goto_ptr();
+}
