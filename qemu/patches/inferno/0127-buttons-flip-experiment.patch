+/*
+ * QEMU_BUTTONS_FLIP (experiment): 1 reports every button key with the other
+ * polarity, 2 only the push buttons (volume and hold), not the ringer switch.
+ */
+static int apple_buttons_flip_mode(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *v = getenv("QEMU_BUTTONS_FLIP");
+        on = v ? atoi(v) : 0;
+    }
+    return on;
+}
+
 #define BUTTON_READER(_btn, _op, _enum)                                   \
     static SMCResult apple_buttons_smc_read_##_btn(                       \
         SMCKey *key, SMCKeyData *data, const void *in, uint8_t in_length) \
     {                                                                     \
         AppleButtonsState *s = key->opaque;                               \
                                                                           \
-        stl_le_p(data->data,                                              \
-                 (s->states & BIT32(SMC_HID_BUTTON_##_enum)) _op 0);      \
+        bool v = (s->states & BIT32(SMC_HID_BUTTON_##_enum)) _op 0;       \
+        if (apple_buttons_flip_mode() == 1 ||                             \
+            (apple_buttons_flip_mode() == 2 &&                            \
+             SMC_HID_BUTTON_##_enum != SMC_HID_BUTTON_RINGER)) {          \
+            v = !v;                                                       \
+        }                                                                 \
+        stl_le_p(data->data, v);                                          \
                                                                           \
         return SMC_RESULT_SUCCESS;                                        \
     }
