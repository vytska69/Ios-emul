index 89779b2..c684ef5 100644
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -207,6 +207,25 @@ static void tb_jmp_cache_clear_page(CPUState *cpu, vaddr page_addr)
  * high), since otherwise we are likely to have a significant amount of
  * conflict misses.
  */
+/*
+ * QEMU_TLB_MIN_BITS=n: no TLB is shrunk below 2^n entries (default
+ * CPU_TLB_DYN_MIN_BITS). A guest that flushes its user TLB on every
+ * context switch kept it near the minimum, where pages evict each other.
+ */
+static size_t tlb_min_entries(void)
+{
+    static size_t min;
+    if (unlikely(!min)) {
+        const char *v = getenv("QEMU_TLB_MIN_BITS");
+        int bits = v ? atoi(v) : 0;
+        if (bits < CPU_TLB_DYN_MIN_BITS || bits > 16) {
+            bits = CPU_TLB_DYN_MIN_BITS;
+        }
+        min = (size_t)1 << bits;
+    }
+    return min;
+}
+
 static void tlb_mmu_resize_locked(CPUTLBDesc *desc, CPUTLBDescFast *fast,
                                   int64_t now)
 {
@@ -241,7 +260,7 @@ static void tlb_mmu_resize_locked(CPUTLBDesc *desc, CPUTLBDescFast *fast,
         if (expected_rate > 70) {
             ceil *= 2;
         }
-        new_size = MAX(ceil, 1 << CPU_TLB_DYN_MIN_BITS);
+        new_size = MAX(ceil, tlb_min_entries());
     }
 
     if (new_size == old_size) {
@@ -268,7 +287,7 @@ static void tlb_mmu_resize_locked(CPUTLBDesc *desc, CPUTLBDescFast *fast,
      * size, aborting if we cannot even allocate the smallest TLB we support.
      */
     while (fast->table == NULL || desc->fulltlb == NULL) {
-        if (new_size == (1 << CPU_TLB_DYN_MIN_BITS)) {
