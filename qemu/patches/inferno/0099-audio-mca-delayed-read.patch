+/*
+ * Consumes up to len bytes of the endpoint's queued buffers, as
+ * apple_sio_dma_read does, without copying them: each contiguous piece's DMA
+ * address and length goes to cb, so a device can read the bytes later
+ * (apple_sio_dma_peek). Returns the bytes consumed.
+ */
+uint64_t apple_sio_dma_consume(AppleSIODMAEndpoint *ep, uint64_t len,
+                               void (*cb)(void *opaque, uint64_t addr,
+                                          uint64_t n),
+                               void *opaque)
+{
+    AppleSIOState *s;
+    SIODMABuffer *buf;
+    uint64_t taken = 0;
+
+    assert_cmpuint(ep->direction, ==, DMA_DIRECTION_TO_DEVICE);
+
+    QEMU_LOCK_GUARD(&ep->mutex);
+
+    s = container_of(ep, AppleSIOState, eps[ep->id]);
+    while (len > taken) {
+        buf = QTAILQ_FIRST(&ep->buffers);
+        if (buf == NULL || !apple_sio_dma_map_buf(ep, buf)) {
+            break;
+        }
+        uint64_t off = buf->completed, addr = 0, room = 0;
+        for (int i = 0; i < buf->sgl.nsg; ++i) {
+            if (off < buf->sgl.sg[i].len) {
+                addr = buf->sgl.sg[i].base + off;
+                room = buf->sgl.sg[i].len - off;
+                break;
+            }
+            off -= buf->sgl.sg[i].len;
+        }
+        uint64_t piece = MIN(MIN(len - taken, buf->iov.size - buf->completed),
+                             room);
+        if (piece == 0) {
+            break;
+        }
+        cb(opaque, addr, piece);
+        taken += piece;
+        buf->completed += piece;
+        if (buf->completed >= buf->iov.size) {
+            apple_sio_dma_writeback(s, ep, buf);
+        }
+    }
+    return taken;
+}
+
+/* Reads len bytes at DMA address addr of the endpoint's controller. */
+bool apple_sio_dma_peek(AppleSIODMAEndpoint *ep, uint64_t addr, void *buffer,
+                        uint64_t len)
+{
+    AppleSIOState *s = container_of(ep, AppleSIOState, eps[ep->id]);
+
+    return dma_memory_read(&s->dma_as, addr, buffer, len,
+                           MEMTXATTRS_UNSPECIFIED) == MEMTX_OK;
+}
+
 uint64_t apple_sio_dma_write(AppleSIODMAEndpoint *ep, void *buffer,
                              uint64_t len)
 {
