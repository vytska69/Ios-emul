+/*
+ * True when every interrupt in @interrupt_request is masked right now, so
+ * arm_cpu_exec_interrupt would take none of them. A kernel that runs with
+ * an interrupt pending and masked (iOS does, around its FIQ timer and IPIs)
+ * otherwise takes the BQL at every return to the execution loop just to find
+ * that out. Reads only this CPU's state; any other bit answers false.
+ */
+bool arm_cpu_exec_interrupt_masked(CPUState *cs, int interrupt_request)
+{
+    CPUARMState *env = cpu_env(cs);
+    uint32_t cur_el;
+    bool secure;
+    uint64_t hcr_el2;
+    static const struct { int bit; unsigned excp; bool phys; } irqs[] = {
+        { CPU_INTERRUPT_FIQ, EXCP_FIQ, true },
+        { CPU_INTERRUPT_HARD, EXCP_IRQ, true },
+        { CPU_INTERRUPT_VIRQ, EXCP_VIRQ, false },
+        { CPU_INTERRUPT_VFIQ, EXCP_VFIQ, false },
+        { CPU_INTERRUPT_VSERR, EXCP_VSERR, false },
+    };
+    int known = CPU_INTERRUPT_FIQ | CPU_INTERRUPT_HARD | CPU_INTERRUPT_VIRQ |
+                CPU_INTERRUPT_VFIQ | CPU_INTERRUPT_VSERR;
+
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        const char *v = getenv("QEMU_IRQ_MASKED_NOBQL");
+        enabled = !(v && v[0] == '0');
+    }
+    if (!enabled || (interrupt_request & ~known)) {
+        return false;
+    }
+    if (cpu_isar_feature(aa64_nmi, env_archcpu(env))) {
+        return false;
+    }
+    cur_el = arm_current_el(env);
+    secure = arm_is_secure(env);
+    hcr_el2 = arm_hcr_el2_eff(env);
+    for (int i = 0; i < ARRAY_SIZE(irqs); i++) {
+        uint32_t target_el;
+
+        if (!(interrupt_request & irqs[i].bit)) {
+            continue;
+        }
+        target_el = irqs[i].phys ?
+            arm_phys_excp_target_el(cs, irqs[i].excp, cur_el, secure) : 1;
+        if (arm_excp_unmasked(cs, irqs[i].excp, target_el, cur_el, secure,
+                              hcr_el2)) {
+            return false;
+        }
+    }
+    return true;
+}
