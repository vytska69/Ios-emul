+    }
+    asm volatile("ucvtf d0, %x1\n\t"
+                 "fmov %x0, d0"
+                 : "=r"(out) : "r"(a) : "v0");
+    na_end(s, &st);
+    *r = out;
+    return true;
+}
+
+static inline bool na_f64_compare(float64 a, float64 b, float_status *s, FloatRelation *r)
+{
+    NativeArmFP st;
+    uint64_t nzcv;
+    if (!na_begin(s, false, &st)) {
+        return false;
+    }
+    asm volatile("fmov d0, %x1\n\t"
+                 "fmov d1, %x2\n\t"
+                 "fcmpe d0, d1\n\t"
+                 "mrs %0, nzcv"
+                 : "=r"(nzcv) : "r"(a), "r"(b) : "v0", "v1", "cc");
+    na_end(s, &st);
+    switch ((nzcv >> 28) & 0xf) {
+    case 0x6:
+        *r = float_relation_equal;
+        break;
+    case 0x8:
+        *r = float_relation_less;
+        break;
+    case 0x2:
+        *r = float_relation_greater;
+        break;
+    default:
+        *r = float_relation_unordered;
+        break;
+    }
+    return true;
+}
+
+static inline bool na_f64_compare_quiet(float64 a, float64 b, float_status *s, FloatRelation *r)
+{
+    NativeArmFP st;
+    uint64_t nzcv;
+    if (!na_begin(s, false, &st)) {
+        return false;
+    }
+    asm volatile("fmov d0, %x1\n\t"
+                 "fmov d1, %x2\n\t"
+                 "fcmp d0, d1\n\t"
+                 "mrs %0, nzcv"
+                 : "=r"(nzcv) : "r"(a), "r"(b) : "v0", "v1", "cc");
+    na_end(s, &st);
+    switch ((nzcv >> 28) & 0xf) {
+    case 0x6:
+        *r = float_relation_equal;
+        break;
+    case 0x8:
+        *r = float_relation_less;
+        break;
+    case 0x2:
+        *r = float_relation_greater;
+        break;
+    default:
+        *r = float_relation_unordered;
+        break;
+    }
+    return true;
+}
