+    }
+    asm volatile("fmov s0, %w1\n\t"
+                 "fmov s1, %w2\n\t"
+                 "fsub s0, s0, s1\n\t"
+                 "fmov %w0, s0"
+                 : "=r"(out) : "r"(a), "r"(b) : "v0", "v1");
+    na_end(s, &st);
+    *r = out;
+    return true;
+}
+
+static inline bool na_f32_mul(float32 a, float32 b, float_status *s, float32 *r)
