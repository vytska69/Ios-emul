+static inline bool na_f32_compare(float32 a, float32 b, float_status *s, FloatRelation *r)
+{
+    NativeArmFP st;
+    uint64_t nzcv;
+    if (!na_begin(s, false, &st)) {
+        return false;
+    }
+    asm volatile("fmov s0, %w1\n\t"
+                 "fmov s1, %w2\n\t"
+                 "fcmpe s0, s1\n\t"
+                 "mrs %0, nzcv"
+                 : "=r"(nzcv) : "r"(a), "r"(b) : "v0", "v1", "cc");
+    na_end(s, &st);
+    switch ((nzcv >> 28) & 0xf) {
+    case 0x6:
+        *r = float_relation_equal;
+        break;
+    case 0x8:
+        *r = float_relation_less;
+        break;
+    case 0x2:
+        *r = float_relation_greater;
+        break;
+    default:
+        *r = float_relation_unordered;
+        break;
+    }
+    return true;
+}
