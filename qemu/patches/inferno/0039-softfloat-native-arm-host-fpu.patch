+    return true;
+}
+
+static inline bool na_f32_to_int32(float32 a, FloatRoundMode rmode, int scale,
+                        float_status *s, int32_t *r)
+{
+    NativeArmFP st;
+    int32_t out;
+    if (scale != 0) {
+        return false;
+    }
+    switch (rmode) {
+    case float_round_nearest_even:
+    case float_round_up:
+    case float_round_down:
+    case float_round_to_zero:
+    case float_round_ties_away:
+        break;
+    default:
+        return false;
+    }
+    if (!na_begin(s, true, &st)) {
+        return false;
+    }
+    switch (rmode) {
+    case float_round_nearest_even:
+        asm volatile("fmov s0, %w1\n\t"
+                     "fcvtns %w0, s0"
+                     : "=r"(out) : "r"(a) : "v0");
+        break;
+    case float_round_up:
+        asm volatile("fmov s0, %w1\n\t"
+                     "fcvtps %w0, s0"
+                     : "=r"(out) : "r"(a) : "v0");
+        break;
+    case float_round_down:
+        asm volatile("fmov s0, %w1\n\t"
+                     "fcvtms %w0, s0"
+                     : "=r"(out) : "r"(a) : "v0");
+        break;
+    case float_round_to_zero:
+        asm volatile("fmov s0, %w1\n\t"
+                     "fcvtzs %w0, s0"
+                     : "=r"(out) : "r"(a) : "v0");
+        break;
+    case float_round_ties_away:
+        asm volatile("fmov s0, %w1\n\t"
+                     "fcvtas %w0, s0"
+                     : "=r"(out) : "r"(a) : "v0");
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    na_end(s, &st);
+    *r = out;
+    return true;
+}
+
