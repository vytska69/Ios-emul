+/*
+ * Native floating point for an Arm guest on an AArch64 host.
+ *
+ * Softfloat computes every operation in software, at a hundred or more host
+ * instructions each; iOS draws its whole screen with the CPU (there is no GPU
+ * to emulate), mostly in floating point, so softfloat was a third of QEMU's
+ * time. The host's FPU implements the same Arm architecture as the guest:
+ * with the guest's rounding mode, flush-to-zero and default-NaN settings in
+ * FPCR it gives the guest's result, NaN propagation included, and FPSR
+ * gives its exception flags. Used only for float_status the Arm target marked
+ * native_arm (the FPCR.AH=0 statuses); anything else, or a mode FPCR has no
+ * encoding for, falls through to softfloat.
+ */
+#if defined(__aarch64__)
+
+typedef struct {
+    uint64_t old;
+    uint64_t want;
+} NativeArmFP;
+
+static inline uint64_t na_get_fpcr(void)
+{
+    uint64_t v;
+    asm volatile("mrs %0, fpcr" : "=r"(v));
+    return v;
+}
+
+static inline void na_set_fpcr(uint64_t v)
+{
+    asm volatile("msr fpcr, %0" : : "r"(v));
+}
+
+/* any_rmode: the operation takes its rounding mode from elsewhere. */
+static inline bool na_begin(const float_status *s, bool any_rmode,
+                            NativeArmFP *st)
+{
+    uint64_t want = 0;
+
+    if (likely(!s->native_arm)) {
+        return false;
+    }
+    if (!any_rmode) {
+        switch (s->float_rounding_mode) {
+        case float_round_nearest_even:
+            break;
+        case float_round_up:
+            want = 1ull << 22;
+            break;
+        case float_round_down:
+            want = 2ull << 22;
+            break;
+        case float_round_to_zero:
+            want = 3ull << 22;
+            break;
+        default:
+            return false;
+        }
+    }
+    if (s->flush_to_zero != s->flush_inputs_to_zero) {
+        return false;
+    }
+    if (s->flush_to_zero) {
+        want |= 1ull << 24;
+    }
+    if (s->default_nan_mode) {
+        want |= 1ull << 25;
+    }
+    st->want = want;
+    st->old = na_get_fpcr();
+    if (st->old != want) {
+        na_set_fpcr(want);
+    }
+    asm volatile("msr fpsr, xzr");
+    return true;
+}
+
+static inline void na_end(float_status *s, const NativeArmFP *st)
+{
+    uint64_t fpsr;
+    int f = 0;
+
+    asm volatile("mrs %0, fpsr" : "=r"(fpsr));
+    if (st->old != st->want) {
+        na_set_fpcr(st->old);
+    }
+    if (unlikely(fpsr & 0x9f)) {
+        if (fpsr & 1) {
+            f |= float_flag_invalid;
+        }
+        if (fpsr & 2) {
+            f |= float_flag_divbyzero;
+        }
+        if (fpsr & 4) {
+            f |= float_flag_overflow;
+        }
+        if (fpsr & 8) {
+            f |= float_flag_underflow;
+        }
+        if (fpsr & 16) {
+            f |= float_flag_inexact;
+        }
+        if (fpsr & 128) {
+            f |= float_flag_input_denormal_flushed;
+        }
+        s->float_exception_flags |= f;
+    }
+}
+
+static inline bool na_f32_add(float32 a, float32 b, float_status *s, float32 *r)
+{
+    NativeArmFP st;
+    float32 out;
+    if (!na_begin(s, false, &st)) {
+        return false;
+    }
+    asm volatile("fmov s0, %w1\n\t"
+                 "fmov s1, %w2\n\t"
+                 "fadd s0, s0, s1\n\t"
+                 "fmov %w0, s0"
+                 : "=r"(out) : "r"(a), "r"(b) : "v0", "v1");
+    na_end(s, &st);
+    *r = out;
+    return true;
+}
+
+static inline bool na_f32_sub(float32 a, float32 b, float_status *s, float32 *r)
