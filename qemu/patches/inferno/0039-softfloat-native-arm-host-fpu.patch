+    asm volatile("fmov s0, %w1\n\t"
+                 "fmov s1, %w2\n\t"
+                 "fmov s2, %w3\n\t"
+                 "fmadd s0, s0, s1, s2\n\t"
+                 "fmov %w0, s0"
+                 : "=r"(out) : "r"(a), "r"(b), "r"(c) : "v0", "v1", "v2");
+    na_end(s, &st);
