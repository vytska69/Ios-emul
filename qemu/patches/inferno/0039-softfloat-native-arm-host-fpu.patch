diff --git a/fpu/softfloat-fast-arm.c.inc b/fpu/softfloat-fast-arm.c.inc
new file mode 100644
index 0000000..256ad36
--- /dev/null
+++ b/fpu/softfloat-fast-arm.c.inc
@@ -0,0 +1,351 @@
+/*
+ * Fast paths for Arm guest floating point on an AArch64 host.
+ *
+ * Softfloat computes every operation in software; iOS draws its whole screen
+ * with the CPU (there is no GPU to emulate), mostly in floating point, so
+ * softfloat was a third of QEMU's time. For the common case (normal inputs, a
+ * normal result, round to nearest) the host FPU gives the guest's result, and
+ * the only exception flag that can arise is inexact. That one is found without
+ * touching FPSR (reading or clearing it costs more than softfloat on Apple
+ * cores): the rounding error of a product, quotient or square root is exactly
+ * representable and an FMA computes it; for a sum, TwoSum does. Anything else
+ * (NaN, infinity, subnormals, results near the bottom of the range, another
+ * rounding mode) goes to softfloat as before.
+ *
+ * QEMU's own threads run with the host's default FPCR (round to nearest, no
+ * flush to zero), which these paths rely on.
+ */
+#if defined(__aarch64__)
+
+#define FASTFP 1
+
+/* QEMU_FAST_FP=0 in the environment turns this off (to compare). */
+static bool fastfp_off;
+
+static void __attribute__((constructor)) fastfp_init(void)
+{
+    const char *v = getenv("QEMU_FAST_FP");
+    fastfp_off = v && v[0] == '0';
+}
+
+static inline bool fastfp_ok(const float_status *s)
+{
+    return likely(s->native_arm) && !fastfp_off &&
+           s->float_rounding_mode == float_round_nearest_even;
+}
+
+static inline float fastfp_f(float32 a)
+{
+    float f;
+    memcpy(&f, &a, 4);
+    return f;
+}
+
+static inline float32 fastfp_u(float f)
+{
+    float32 a;
+    memcpy(&a, &f, 4);
+    return a;
+}
+
+static inline double fastfp_d(float64 a)
+{
+    double f;
+    memcpy(&f, &a, 8);
+    return f;
+}
+
+static inline float64 fastfp_v(double f)
+{
+    float64 a;
+    memcpy(&a, &f, 8);
+    return a;
+}
+
+/* Zero or normal: nothing to flush, no NaN, no infinity. */
+static inline bool f32_zon(float32 a)
+{
+    uint32_t e = (a >> 23) & 0xff;
+    return e != 0xff && (e != 0 || (a & 0x7fffff) == 0);
+}
+
+static inline bool f64_zon(float64 a)
+{
+    uint64_t e = (a >> 52) & 0x7ff;
+    return e != 0x7ff && (e != 0 || (a & 0xfffffffffffffull) == 0);
+}
+
+/*
+ * A result safely inside the normal range: no overflow, and far enough above
+ * the bottom that neither tininess (Arm detects it before rounding) nor an
+ * error term below the normal range can be involved.
+ */
+static inline bool f32_safe(float r)
+{
+    float m = __builtin_fabsf(r);
+    return m >= 0x1p-100f && m <= 0x1p+120f;
+}
+
+static inline bool f64_safe(double r)
+{
+    double m = __builtin_fabs(r);
+    return m >= 0x1p-900 && m <= 0x1p+1000;
+}
+
+/* Inputs whose rounding error terms stay well inside the normal range. */
+static inline bool f32_mid(float x)
+{
+    float m = __builtin_fabsf(x);
+    return m >= 0x1p-60f && m <= 0x1p+60f;
+}
+
+static inline bool f64_mid(double x)
+{
+    double m = __builtin_fabs(x);
+    return m >= 0x1p-500 && m <= 0x1p+500;
+}
+
+static inline void fastfp_inexact(float_status *s, bool inexact)
+{
+    if (inexact) {
+        s->float_exception_flags |= float_flag_inexact;
+    }
+}
+
+#define FASTFP_ARITH(W, T, F, CONV, BACK, ZON, SAFE, FMA, SQRT, MID)                \
+static inline bool fast_f##W##_add(T a, T b, float_status *s, T *r)            \
+{                                                                              \
+    if (!fastfp_ok(s) || !ZON(a) || !ZON(b)) {                                 \
+        return false;                                                          \
+    }                                                                          \
+    F x = CONV(a), y = CONV(b), z = x + y;                                     \
+    if (z == 0) {                                                              \
+        /* Exact (x == -y, or both zero); the host gets the sign right. */    \
+        *r = BACK(z);                                                          \
+        return true;                                                           \
+    }                                                                          \
+    if (!SAFE(z)) {                                                            \
+        return false;                                                          \
+    }                                                                          \
+    if (!(s->float_exception_flags & float_flag_inexact)) {                    \
+        F bb = z - x;                                                          \
+        F err = (x - (z - bb)) + (y - bb);                                     \
+        fastfp_inexact(s, err != 0);                                           \
+    }                                                                          \
+    *r = BACK(z);                                                              \
+    return true;                                                               \
+}                                                                              \
+static inline bool fast_f##W##_sub(T a, T b, float_status *s, T *r)            \
+{                                                                              \
+    return fast_f##W##_add(a, b ^ ((T)1 << (W - 1)), s, r);                    \
+}                                                                              \
+static inline bool fast_f##W##_mul(T a, T b, float_status *s, T *r)            \
+{                                                                              \
+    if (!fastfp_ok(s) || !ZON(a) || !ZON(b)) {                                 \
+        return false;                                                          \
+    }                                                                          \
+    F x = CONV(a), y = CONV(b), z = x * y;                                     \
+    if (x == 0 || y == 0) {                                                    \
+        *r = BACK(z);                                                          \
+        return true;                                                           \
+    }                                                                          \
+    if (!SAFE(z)) {                                                            \
+        return false;                                                          \
+    }                                                                          \
+    if (!(s->float_exception_flags & float_flag_inexact)) {                    \
+        fastfp_inexact(s, FMA(x, y, -z) != 0);                                 \
+    }                                                                          \
+    *r = BACK(z);                                                              \
+    return true;                                                               \
+}                                                                              \
+static inline bool fast_f##W##_div(T a, T b, float_status *s, T *r)            \
+{                                                                              \
+    if (!fastfp_ok(s) || !ZON(a) || !ZON(b) || CONV(b) == 0) {                 \
+        return false;                                                          \
+    }                                                                          \
+    F x = CONV(a), y = CONV(b), z = x / y;                                     \
+    if (x == 0) {                                                              \
+        *r = BACK(z);                                                          \
+        return true;                                                           \
+    }                                                                          \
+    if (!MID(x) || !MID(y) || !SAFE(z)) {                                                            \
+        return false;                                                          \
+    }                                                                          \
+    if (!(s->float_exception_flags & float_flag_inexact)) {                    \
+        fastfp_inexact(s, FMA(-z, y, x) != 0);                                 \
+    }                                                                          \
+    *r = BACK(z);                                                              \
+    return true;                                                               \
+}                                                                              \
+static inline bool fast_f##W##_sqrt(T a, float_status *s, T *r)                \
+{                                                                              \
+    if (!fastfp_ok(s) || !ZON(a) || (a >> (W - 1))) {                          \
+        return false;                                                          \
+    }                                                                          \
+    F x = CONV(a), z = SQRT(x);                                                \
+    if (x == 0) {                                                              \
+        *r = a;                                                                \
+        return true;                                                           \
+    }                                                                          \
+    if (!MID(x) || !SAFE(z)) {                                                            \
+        return false;                                                          \
+    }                                                                          \
+    if (!(s->float_exception_flags & float_flag_inexact)) {                    \
+        fastfp_inexact(s, FMA(-z, z, x) != 0);                                 \
+    }                                                                          \
+    *r = BACK(z);                                                              \
+    return true;                                                               \
+}                                                                              \
+static inline bool fast_f##W##_compare(T a, T b, float_status *s,              \
+                                       FloatRelation *r)                       \
+{                                                                              \
+    /* No NaN, nothing to flush: no flags at all. */                           \
+    if (!likely(s->native_arm) || fastfp_off) {                                \
+        return false;                                                          \
+    }                                                                          \
+    T ea = (a >> (W == 32 ? 23 : 52)) & (W == 32 ? 0xff : 0x7ff);              \
+    T eb = (b >> (W == 32 ? 23 : 52)) & (W == 32 ? 0xff : 0x7ff);              \
+    if ((!ZON(a) && ea != (W == 32 ? 0xff : 0x7ff)) ||                         \
+        (!ZON(b) && eb != (W == 32 ? 0xff : 0x7ff))) {                         \
+        return false; /* subnormal */                                          \
+    }                                                                          \
+    F x = CONV(a), y = CONV(b);                                                \
+    if (x != x || y != y) {                                                    \
+        return false;                                                          \
+    }                                                                          \
+    *r = x < y ? float_relation_less                                           \
+       : x > y ? float_relation_greater : float_relation_equal;               \
+    return true;                                                               \
+}                                                                              \
+static inline bool fast_f##W##_round_to_int(T a, float_status *s, T *r)        \
+{                                                                              \
+    if (!fastfp_ok(s) || !ZON(a)) {                                            \
+        return false;                                                          \
+    }                                                                          \
+    F x = CONV(a), z = W == 32 ? __builtin_rintf(x) : __builtin_rint(x);       \
+    if (!(s->float_exception_flags & float_flag_inexact)) {                    \
+        fastfp_inexact(s, z != x);                                             \
+    }                                                                          \
+    *r = BACK(z);                                                              \
+    return true;                                                               \
+}
+
+FASTFP_ARITH(32, float32, float, fastfp_f, fastfp_u, f32_zon, f32_safe,
+             __builtin_fmaf, __builtin_sqrtf, f32_mid)
+FASTFP_ARITH(64, float64, double, fastfp_d, fastfp_v, f64_zon, f64_safe,
+             __builtin_fma, __builtin_sqrt, f64_mid)
+
+/*
+ * Float to integer with an explicit rounding mode: in range, the host's
+ * conversion is the guest's, and it is inexact when the integer differs.
+ */
+static inline bool fastfp_round(double x, FloatRoundMode rmode, double *z)
+{
+    switch (rmode) {
+    case float_round_nearest_even:
+        *z = __builtin_rint(x);
+        return true;
+    case float_round_to_zero:
+        *z = __builtin_trunc(x);
+        return true;
+    case float_round_down:
+        *z = __builtin_floor(x);
+        return true;
+    case float_round_up:
+        *z = __builtin_ceil(x);
+        return true;
+    case float_round_ties_away:
+        *z = __builtin_round(x);
+        return true;
+    default:
+        return false;
+    }
+}
+
+#define FASTFP_TOINT(NAME, T, ZON, CONV, IT, LO, HI)                           \
+static inline bool NAME(T a, FloatRoundMode rmode, int scale,                  \
+                        float_status *s, IT *r)                                \
+{                                                                              \
+    double x, z;                                                               \
+    if (scale != 0 || !likely(s->native_arm) || fastfp_off || !ZON(a)) {       \
+        return false;                                                          \
+    }                                                                          \
+    x = CONV(a);                                                               \
+    if (!(x > (LO) && x < (HI)) || !fastfp_round(x, rmode, &z)) {              \
+        return false;                                                          \
+    }                                                                          \
+    if (!(z >= (double)(LO) + 1 && z <= (double)(HI) - 1)) {                   \
+        return false;                                                          \
+    }                                                                          \
+    if (!(s->float_exception_flags & float_flag_inexact)) {                    \
+        fastfp_inexact(s, z != x);                                             \
+    }                                                                          \
+    *r = (IT)z;                                                                \
+    return true;                                                               \
+}
+
+/* Strict bounds a little inside the range: the edges go to softfloat. */
+FASTFP_TOINT(fast_f32_to_int32, float32, f32_zon, fastfp_f, int32_t,
+             -2147483648.0, 2147483647.0)
+FASTFP_TOINT(fast_f32_to_uint32, float32, f32_zon, fastfp_f, uint32_t,
+             -1.0, 4294967295.0)
+FASTFP_TOINT(fast_f64_to_int32, float64, f64_zon, fastfp_d, int32_t,
+             -2147483648.0, 2147483647.0)
+FASTFP_TOINT(fast_f64_to_uint32, float64, f64_zon, fastfp_d, uint32_t,
+             -1.0, 4294967295.0)
+FASTFP_TOINT(fast_f32_to_int64, float32, f32_zon, fastfp_f, int64_t,
+             -0x1p53, 0x1p53)
+FASTFP_TOINT(fast_f64_to_int64, float64, f64_zon, fastfp_d, int64_t,
+             -0x1p53, 0x1p53)
+FASTFP_TOINT(fast_f32_to_uint64, float32, f32_zon, fastfp_f, uint64_t,
+             -1.0, 0x1p53)
+FASTFP_TOINT(fast_f64_to_uint64, float64, f64_zon, fastfp_d, uint64_t,
+             -1.0, 0x1p53)
+
+/* Integer to float: exact below 2^24 (float) or 2^53 (double). */
+static inline bool fast_int64_to_f32(int64_t a, int scale, float_status *s,
+                                     float32 *r)
+{
+    if (scale != 0 || !likely(s->native_arm) || fastfp_off ||
+        a < -(1 << 24) || a > (1 << 24)) {
+        return false;
+    }
+    *r = fastfp_u((float)a);
+    return true;
+}
+
+static inline bool fast_uint64_to_f32(uint64_t a, int scale, float_status *s,
+                                      float32 *r)
+{
+    if (scale != 0 || !likely(s->native_arm) || fastfp_off || a > (1 << 24)) {
+        return false;
+    }
+    *r = fastfp_u((float)a);
+    return true;
+}
+
+static inline bool fast_int64_to_f64(int64_t a, int scale, float_status *s,
+                                     float64 *r)
+{
+    if (scale != 0 || !likely(s->native_arm) || fastfp_off ||
+        a < -(1ll << 53) || a > (1ll << 53)) {
+        return false;
+    }
+    *r = fastfp_v((double)a);
+    return true;
+}
+
+static inline bool fast_uint64_to_f64(uint64_t a, int scale, float_status *s,
+                                      float64 *r)
+{
+    if (scale != 0 || !likely(s->native_arm) || fastfp_off ||
+        a > (1ull << 53)) {
+        return false;
+    }
+    *r = fastfp_v((double)a);
+    return true;
+}
+
+#else
+#define FASTFP 0
+#endif
