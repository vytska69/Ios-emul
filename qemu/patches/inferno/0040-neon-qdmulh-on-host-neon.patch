     }
@@ -528,6 +611,13 @@ void HELPER(neon_sqdmulh_s)(void *vd, void *vn, void *vm,
     intptr_t i, opr_sz = simd_oprsz(desc);
     int32_t *d = vd, *n = vn, *m = vm;
 
+#if defined(__aarch64__)
+    if (native_qdmulh_s(d, n, m, opr_sz, false, vq)) {
