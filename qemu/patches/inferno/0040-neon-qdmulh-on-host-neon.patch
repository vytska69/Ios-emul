 #include "qemu/int128.h"
 #include "crypto/clmul.h"
 #include "vec_internal.h"
+#if defined(__aarch64__)
+#include <arm_neon.h>
+
+/*
+ * SQDMULH/SQRDMULH on the host's NEON: the same Arm instructions, a whole
+ * vector at a time instead of one element per call of do_sqrdmlah_*. iOS's
+ * CPU renderer uses them for every pixel it blends. They saturate only for
+ * MIN * MIN, which is what sets QC.
+ */
+static bool native_qdmulh_h(int16_t *d, const int16_t *n, const int16_t *m,
+                            intptr_t opr_sz, bool round, uint32_t *qc)
+{
+    intptr_t i;
+
+    if (opr_sz == 8) {
+        int16x4_t a = vld1_s16(n), b = vld1_s16(m);
+        uint16x4_t sat = vand_u16(vceq_s16(a, vdup_n_s16(INT16_MIN)),
+                                  vceq_s16(b, vdup_n_s16(INT16_MIN)));
+        vst1_s16(d, round ? vqrdmulh_s16(a, b) : vqdmulh_s16(a, b));
+        if (vmaxv_u16(sat)) {
+            *qc = 1;
+        }
+        return true;
+    }
+    if (opr_sz % 16) {
+        return false;
+    }
+    for (i = 0; i < opr_sz / 2; i += 8) {
+        int16x8_t a = vld1q_s16(n + i), b = vld1q_s16(m + i);
+        uint16x8_t sat = vandq_u16(vceqq_s16(a, vdupq_n_s16(INT16_MIN)),
+                                   vceqq_s16(b, vdupq_n_s16(INT16_MIN)));
+        vst1q_s16(d + i, round ? vqrdmulhq_s16(a, b) : vqdmulhq_s16(a, b));
+        if (vmaxvq_u16(sat)) {
+            *qc = 1;
+        }
+    }
+    return true;
+}
+
+static bool native_qdmulh_s(int32_t *d, const int32_t *n, const int32_t *m,
+                            intptr_t opr_sz, bool round, uint32_t *qc)
+{
+    intptr_t i;
+
+    if (opr_sz == 8) {
+        int32x2_t a = vld1_s32(n), b = vld1_s32(m);
+        uint32x2_t sat = vand_u32(vceq_s32(a, vdup_n_s32(INT32_MIN)),
+                                  vceq_s32(b, vdup_n_s32(INT32_MIN)));
+        vst1_s32(d, round ? vqrdmulh_s32(a, b) : vqdmulh_s32(a, b));
+        if (vmaxv_u32(sat)) {
+            *qc = 1;
+        }
+        return true;
+    }
+    if (opr_sz % 16) {
+        return false;
+    }
+    for (i = 0; i < opr_sz / 4; i += 4) {
+        int32x4_t a = vld1q_s32(n + i), b = vld1q_s32(m + i);
+        uint32x4_t sat = vandq_u32(vceqq_s32(a, vdupq_n_s32(INT32_MIN)),
+                                   vceqq_s32(b, vdupq_n_s32(INT32_MIN)));
+        vst1q_s32(d + i, round ? vqrdmulhq_s32(a, b) : vqdmulhq_s32(a, b));
+        if (vmaxvq_u32(sat)) {
+            *qc = 1;
+        }
+    }
+    return true;
+}
+#endif
 
