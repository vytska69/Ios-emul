+/*
+ * AppleCredentialManager's commands ('scrd'). There is no credential store
+ * here: each request gets an empty reply right away. Unanswered, every one
+ * timed out after 5 s, some with ACM's lock held, and whatever waited for the
+ * keychain or for credentials (Settings, VoiceOver, the apps they start)
+ * stalled for seconds at a time, or long enough to be killed as hung.
+ *
+ * The message: byte 0 endpoint, byte 1 the request (echoed), bytes 2-3 the
+ * reply's length in the receive buffer, bytes 4-7 an error (0: none). The
+ * reply starts with an SCRDResponsePayload_v1 header: byte 0 a version (not 0),
+ * bytes 2-3 the header's size, after which comes the command's output (none).
+ */
+static void apple_sep_sim_handle_scrd_msg(AppleSEPSimState *s,
+                                          SEPMessage *msg)
+{
+    uint8_t payload[8] = { 1, 0, sizeof(payload), 0 };
+
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "SEP scrd request %u, %u bytes: empty reply\n", msg->tag,
+                  (unsigned)(msg->op | (msg->param << 8)));
+    if (s->ool_state[EP_SECURE_CREDENTIALS].out_addr == 0) {
+        return;
+    }
+    dma_memory_write(s->dma_as, s->ool_state[EP_SECURE_CREDENTIALS].out_addr,
+                     payload, sizeof(payload), MEMTXATTRS_UNSPECIFIED);
+    apple_sep_sim_send_message(s, EP_SECURE_CREDENTIALS, msg->tag,
+                               sizeof(payload) & 0xff, sizeof(payload) >> 8, 0);
+}
+
 static void apple_sep_sim_handle_messages(void *opaque)
 {
     AppleSEPSimState *s = opaque;
@@ -1094,9 +1123,7 @@ static void apple_sep_sim_handle_messages(void *opaque)
                           "EP_ART_REQUESTS: Unknown opcode %d\n", sep_msg->op);
             break;
         case EP_SECURE_CREDENTIALS:
-            qemu_log_mask(LOG_GUEST_ERROR,
-                          "EP_SECURE_CREDENTIALS: Unknown opcode %d\n",
-                          sep_msg->op);
+            apple_sep_sim_handle_scrd_msg(s, sep_msg);
             break;
         case EP_XART_SLAVE:
             apple_sep_sim_handle_xart_msg(s, true, sep_msg);
