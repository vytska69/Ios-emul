     qemu_irq_raise(cpu->fast_ipi);
 }
 
+/*
+ * Delivery from an IPI_RR write. Without the BQL (QEMU_IPI_RR_NOBQL) the
+ * lock is taken only when the target has no IPI waiting, since raising the
+ * FIQ line needs it; a target that already has one drops the new IPI, as
+ * apple_a13_deliver_ipi does.
+ */
+static void apple_a13_rr_deliver_ipi(AppleA13State *cpu, uint64_t src_cpu)
+{
+    if (bql_locked()) {
+        apple_a13_deliver_ipi(cpu, src_cpu, IPI_RR_TYPE_IMMEDIATE);
+        return;
+    }
+    if (qatomic_read(&cpu->ipi_sr)) {
+        return;
+    }
+    bql_lock();
+    apple_a13_deliver_ipi(cpu, src_cpu, IPI_RR_TYPE_IMMEDIATE);
+    bql_unlock();
+}
