+static bool apple_a13_ipi_rr_nobql_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *v = getenv("QEMU_IPI_RR_NOBQL");
+        on = v ? atoi(v) != 0 : 0;
+    }
+    return on;
+}
