diff --git a/hw/arm/apple-silicon/mt-spi.c b/hw/arm/apple-silicon/mt-spi.c
index f6388d7..dce6f55 100644
--- a/hw/arm/apple-silicon/mt-spi.c
+++ b/hw/arm/apple-silicon/mt-spi.c
@@ -90,6 +90,12 @@ struct AppleMTSPIState {
     uint8_t frame;
     QEMUTimer *timer;
     QEMUTimer *end_timer;
+    /// Signals "data ready" until the host first talks the HID protocol: a
+    /// controller that boots without the HBPP bootloader (iOS 14's
+    /// AppleHIDTransportDeviceSPI with use-static-config) announces itself
+    /// with its interrupt, and the host waits for that before its first read.
+    QEMUTimer *ready_timer;
+    bool ll_seen;
     int16_t x;
     int16_t y;
     int16_t prev_x;
@@ -752,6 +758,8 @@ static void apple_mt_spi_handle_fw(AppleMTSPIState *s)
 {
     uint8_t packet_type;
 
+    s->ll_seen = true;
+
     if (apple_mt_spi_buf_pos_at_start(&s->rx)) {
         apple_mt_spi_buf_set_capacity(&s->rx, sizeof(uint32_t) * 2);
         apple_mt_spi_push_preamble(&s->tx);
@@ -1014,6 +1022,24 @@ static void apple_mt_spi_mouse_event(void *opaque, int dx, int dy, int dz,
                                     NANOSECONDS_PER_SECOND / 10);
     }
 }
+static void apple_mt_spi_ready_tick(void *opaque)
+{
+    AppleMTSPIState *s = opaque;
+
+    QEMU_LOCK_GUARD(&s->lock);
+
+    if (s->ll_seen) {
+        return;
+    }
+    if (apple_mt_spi_buf_is_empty(&s->pending_hbpp) &&
+        QTAILQ_EMPTY(&s->pending_fw)) {
+        qemu_irq_raise(s->irq);
+        qemu_irq_lower(s->irq);
+    }
+    timer_mod(s->ready_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                                  NANOSECONDS_PER_SECOND);
+}
+
 static void apple_mt_spi_realize(SSIPeripheral *dev, Error **errp)
 {
     AppleMTSPIState *s;
@@ -1041,6 +1067,7 @@ static void apple_mt_spi_reset_enter(Object *obj, ResetType type)
 
     timer_del(s->timer);
     timer_del(s->end_timer);
+    timer_del(s->ready_timer);
 
     s->btn_state = 0;
     s->prev_btn_state = 0;
@@ -1054,6 +1081,7 @@ static void apple_mt_spi_reset_enter(Object *obj, ResetType type)
     apple_mt_spi_buf_free(&s->tx);
     apple_mt_spi_buf_free(&s->rx);
     apple_mt_spi_buf_free(&s->pending_hbpp);
+    s->ll_seen = false;
 
     QTAILQ_FOREACH_SAFE (packet, &s->pending_fw, next, packet_next) {
         QTAILQ_REMOVE(&s->pending_fw, packet, next);
@@ -1071,6 +1099,8 @@ static void apple_mt_spi_reset_hold(Object *obj, ResetType type)
     QEMU_LOCK_GUARD(&s->lock);
 
     qemu_irq_raise(s->irq);
+    timer_mod(s->ready_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                                  NANOSECONDS_PER_SECOND);
 }
 
 static void apple_mt_spi_class_init(ObjectClass *klass, const void *data)
@@ -1101,6 +1131,8 @@ static void apple_mt_instance_init(Object *obj)
     s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, apple_mt_spi_timer_tick, s);
     s->end_timer =
         timer_new_ns(QEMU_CLOCK_VIRTUAL, apple_mt_spi_end_timer_tick, s);
+    s->ready_timer =
+        timer_new_ns(QEMU_CLOCK_VIRTUAL, apple_mt_spi_ready_tick, s);
 
     QTAILQ_INIT(&s->pending_fw);
 
