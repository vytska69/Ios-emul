+/* F1-F10 are the buttons; with a USB keyboard attached they still come here. */
+static bool apple_buttons_claims_key(DeviceState *dev, InputKeyEvent *key)
+{
+    int qcode = qemu_input_key_value_to_qcode(key->key);
+
+    return qcode >= Q_KEY_CODE_F1 && qcode <= Q_KEY_CODE_F10;
+}
+
 static const QemuInputHandler apple_buttons_handler = {
     .name = "Apple Buttons",
     .mask = INPUT_EVENT_MASK_KEY,
     .event = apple_buttons_handle_event,
+    .claims_key = apple_buttons_claims_key,
 };
 
 static void apple_buttons_realize(DeviceState *dev, Error **errp)
