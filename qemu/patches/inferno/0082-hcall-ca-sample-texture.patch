+    cpu_stq_le_mmuidx_ra(env, frame + 0x0, tex, mmu, ra);
+    cpu_stl_le_mmuidx_ra(env, frame + 0x8, w2, mmu, ra);
+    cpu_stl_le_mmuidx_ra(env, frame + 0xc, w3in, mmu, ra);
+    cpu_stq_le_mmuidx_ra(env, frame + 0x10, x[4], mmu, ra);
+    cpu_stq_le_mmuidx_ra(env, frame + 0x18, x[5], mmu, ra);
+    cpu_stq_le_mmuidx_ra(env, frame + 0x20, x[6], mmu, ra);
+    cpu_stq_le_mmuidx_ra(env, frame + 0x28, x[7], mmu, ra);
+    cpu_stb_mmuidx_ra(env, frame + 0x30, mode, mmu, ra);
+    cpu_stl_le_mmuidx_ra(env, frame + 0x34, (uint32_t)u, mmu, ra);
+    cpu_stl_le_mmuidx_ra(env, frame + 0x38, (uint32_t)du, mmu, ra);
+    cpu_stl_le_mmuidx_ra(env, frame + 0x3c, (uint32_t)v, mmu, ra);
+    cpu_stl_le_mmuidx_ra(env, frame + 0x40, (uint32_t)dv, mmu, ra);
+    if (mode == 5 || mode == 3) {
+        for (int i = 0; i < 16; i += 8) {
+            cpu_stq_le_mmuidx_ra(env, frame + 0x54 + i,
+                                 cpu_ldq_le_mmuidx_ra(env, ctx2 + 0x1d8 + i, mmu, ra),
+                                 mmu, ra);
+        }
+    }
+    p = cpu_ldq_le_mmuidx_ra(env, ctx2 + 0x1d0, mmu, ra);
+    if (p) {
+        uint32_t c;
+
+        cpu_stl_le_mmuidx_ra(env, frame + 0x44,
+                             cpu_ldub_mmuidx_ra(env, p + 4, mmu, ra) ? 0xbf800000u : 0x3f800000u,
+                             mmu, ra);
+        cpu_stl_le_mmuidx_ra(env, frame + 0x48, cpu_ldl_le_mmuidx_ra(env, p + 0x10, mmu, ra),
+                             mmu, ra);
+        c = cpu_ldl_le_mmuidx_ra(env, p, mmu, ra) - 1;
+        if (c == 0) {
