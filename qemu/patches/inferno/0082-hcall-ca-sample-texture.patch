+/*
+ * QuartzCore (18A373) CA::OGL::SW::sample_texture(SWContext &, Texture const *, int,
+ * unsigned, Poly::Vertex const *, x5, x6, x7, uchar mode, unsigned count, unsigned *out),
+ * the per-span setup of the software rasterizer: the SamplerData it builds on its stack,
+ * the sampler it picks from the texture's table, and the alpha-first swizzle after.
+ * Written from its code and checked against it in Unicorn
+ * (scripts/vgpu-check/check_sample_texture.py). When the sampler is one this file runs
+ * natively (3, 4, 5, 7, 10) the whole call is done here and x16 = 1 (the patch then
+ * returns); otherwise the prologue the patch replaced (pacibsp; sub sp, sp, #0xa0;
+ * stp x22, x21, [sp, #0x70]) is done here, x16 = 0, and the function goes on.
+ */
+#define CA_ST_HINT 0x183707e18ull
+#define CA_ST_K_D04 0x183876d04ull
+
+static inline int32_t ca_fcvtzs16(float f)
+{
+    double d;
+
+    if (f != f) {
+        return 0;
+    }
+    d = (double)f * 65536.0;
+    if (d >= 2147483648.0) {
+        return INT32_MAX;
+    }
+    if (d <= -2147483649.0) {
+        return INT32_MIN;
+    }
+    return (int32_t)d;
+}
