+    int32_t du = ca_fcvtzs16(s4), dv = ca_fcvtzs16(s2);
+    w3 = ((t1c != 1) && !(s6 == 0.0f)) | w11;
+    if ((w3in & 4) || mode) {
+        w3 |= 6;
+    } else {
+        int bit2 = 0;
+        uint32_t n1 = count - 1;
+        int32_t e9 = (int32_t)(n1 * (uint32_t)du + (uint32_t)u);
+        int32_t e12 = (int32_t)(n1 * (uint32_t)dv + (uint32_t)v);
+        int32_t lo_u = du < 0 ? e9 : u, hi_u = du < 0 ? u : e9;
+        int32_t lo_v = dv < 0 ? e12 : v, hi_v = dv < 0 ? v : e12;
