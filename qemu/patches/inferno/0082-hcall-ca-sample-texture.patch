+static void ios_hcall_ca_sample_texture(CPUARMState *env, uintptr_t ra)
+{
+    uint64_t *x = env->xregs;
+    int mmu = arm_env_mmu_index(env);
+    uint64_t sp = x[31], slide = env->pc - CA_ST_HINT, frame = sp - 0xa0;
+    uint64_t tex = x[1], ctx2, p, out, tab, fn, args[18] = { 0 };
+    uint32_t w2 = (uint32_t)x[2], w3in = (uint32_t)x[3], count, w11, w3;
+    uint8_t mode, b40, b41, fmt;
+    uint32_t t18, t1c;
+    int32_t t20, t24;
+    int64_t vi = (int64_t)(int32_t)(w2 << 1) * 4 + 0x20;
+    float s0 = 0.5f, s1, s2, s3, s4, s5, s6;
+    void (*run)(CPUARMState *, uintptr_t) = NULL;
+    int affine = -1;
+
+    mode = cpu_ldub_mmuidx_ra(env, sp, mmu, ra);
+    count = cpu_ldl_le_mmuidx_ra(env, sp + 4, mmu, ra);
+    out = cpu_ldq_le_mmuidx_ra(env, sp + 8, mmu, ra);
+    b40 = cpu_ldub_mmuidx_ra(env, tex + 0x40, mmu, ra);
+    b41 = cpu_ldub_mmuidx_ra(env, tex + 0x41, mmu, ra);
+    t18 = cpu_ldl_le_mmuidx_ra(env, tex + 0x18, mmu, ra);
+    t1c = cpu_ldl_le_mmuidx_ra(env, tex + 0x1c, mmu, ra);
+    w11 = b40;
+    if (b40 == b41) {
+        s1 = (float)t18;
+        s2 = (float)t1c;
+    } else {
+        if (!(w3in & 4)) {
+            s1 = ca_ldf(env, x[5] + vi, mmu, ra);
+            s2 = ca_ldf(env, x[5] + vi + 4, mmu, ra);
+            s3 = fabsf(s1);
+            s4 = fabsf(ca_ldf(env, x[6] + vi, mmu, ra));
+            s1 = ca_ldf(env, x[6] + vi + 4, mmu, ra);
+            s3 = s3 + s4;
+            s2 = fabsf(s2);
+        } else {
+            s1 = 1.0f / ca_ldf(env, x[4] + 0xc, mmu, ra);
+            s2 = ca_ldf(env, x[5] + vi, mmu, ra);
+            s4 = ca_ldf(env, x[5] + vi + 4, mmu, ra);
+            s2 = fabsf(s2 * s1);
+            s3 = fabsf(s1 * ca_ldf(env, x[6] + vi, mmu, ra));
+            s5 = ca_ldf(env, x[6] + vi + 4, mmu, ra);
+            s3 = s2 + s3;
+            s2 = fabsf(s1 * s4);
+            s1 = s1 * s5;
+        }
+        s1 = fabsf(s1);
+        s4 = s2 + s1;
+        s1 = (float)t18;
+        s2 = (float)t1c;
+        s4 = s4 * s2;
+        s3 = fmaf(s3, s1, s4);
+        s3 = s3 * s0;
+        w11 = s3 < ca_ldf(env, CA_ST_K_D04 + slide, mmu, ra) ? b41 : b40;
+    }
+    s3 = ca_ldf(env, x[4] + vi, mmu, ra) * s1;
+    s5 = ca_ldf(env, x[4] + vi + 4, mmu, ra);
+    s4 = ca_ldf(env, x[5] + vi, mmu, ra) * s1;
+    s6 = ca_ldf(env, x[5] + vi + 4, mmu, ra);
+    s1 = s5 * s2;
+    s2 = s6 * s2;
