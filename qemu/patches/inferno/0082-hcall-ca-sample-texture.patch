+        if (w11 & 8) {
+            lo_u = (int32_t)((uint32_t)lo_u - 0x8000);
+            hi_u = (int32_t)((uint32_t)hi_u + 0x8000);
+            lo_v = (int32_t)((uint32_t)lo_v - 0x8000);
+            hi_v = (int32_t)((uint32_t)hi_v + 0x8000);
+        }
+        if (lo_u < 0 || lo_v < 0) {
+            bit2 = 1;
+        } else {
+            t20 = (int32_t)cpu_ldl_le_mmuidx_ra(env, tex + 0x20, mmu, ra);
+            if (hi_u > t20) {
+                bit2 = 1;
+            } else {
+                t24 = (int32_t)cpu_ldl_le_mmuidx_ra(env, tex + 0x24, mmu, ra);
+                if (hi_v > t24 || (s3 >= 0.0f ? s3 : -s3) > 8192.0f ||
+                    (s1 >= 0.0f ? s1 : -s1) > 8192.0f) {
+                    bit2 = 1;
+                } else {
+                    float n = (float)n1;
+                    float t6 = fmaf(s4, n, s3), t3 = -fmaf(s4, n, s3);
+                    float u3 = fmaf(s2, n, s1), u1 = -fmaf(s2, n, s1);
+
+                    if ((!(t6 >= 0.0f) ? t3 : t6) > 8192.0f ||
+                        (!(u3 >= 0.0f) ? u1 : u3) > 8192.0f) {
+                        bit2 = 1;
+                    }
+                }
+            }
+        }
+        if (bit2) {
+            w3 |= 2;
+        }
+    }
+    ctx2 = cpu_ldq_le_mmuidx_ra(env, x[0] + 8, mmu, ra);
+    tab = cpu_ldq_le_mmuidx_ra(env, tex + 0x30, mmu, ra);
+    fn = helper_xpaci(env, cpu_ldq_le_mmuidx_ra(env, tab + 8ull * w3, mmu, ra)) - slide;
+    switch (fn) {
+    case CA_SAMPLER_ARGB8_ADDR:
+        run = ios_hcall_ca_image_sampler_argb8;
+        break;
+    case 0x1837200e4ull:
+        affine = 1;
+        break;
+    case 0x1837211acull:
+        affine = 0;
+        break;
+    case 0x183721590ull:
+        run = ios_hcall_ca_nearest_argb8;
+        break;
+    case 0x183721014ull:
+        run = ios_hcall_ca_clamp_argb8;
+        break;
