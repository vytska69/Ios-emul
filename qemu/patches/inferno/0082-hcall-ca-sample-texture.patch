+            memcpy(&lw, &lo, 4);
+            memcpy(&hw, &hi, 4);
+            cpu_stl_le_mmuidx_ra(env, frame + 0x4c, lw, mmu, ra);
+            cpu_stl_le_mmuidx_ra(env, frame + 0x50, hw, mmu, ra);
+        }
+    }
