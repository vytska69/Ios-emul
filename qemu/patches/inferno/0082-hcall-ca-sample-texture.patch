+    /* The sampler, natively, on these arguments rather than the guest's registers. */
+    args[0] = frame;
+    args[1] = count;
+    args[2] = out;
+    args[17] = CA_SAMPLER_ARGB8_ADDR + slide;
+    ca_args = args;
+    if (run) {
+        run(env, ra);
+    } else {
+        ios_hcall_ca_affine_sampler(env, ra, affine == 1);
+    }
+    ca_args = NULL;
+
+    fmt = cpu_ldub_mmuidx_ra(env, ctx2 + (uint64_t)w2 + 0x11, mmu, ra);
+    if (fmt == 0xf && count) {
+        CaCache lc, sc;
