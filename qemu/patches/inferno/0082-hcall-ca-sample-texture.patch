+            uint32_t e = (uint32_t)((((uint64_t)(w >> 24)) << 32 | w) >> 24);
+            ca_st32(env, &sc, out + 4ull * i, e | e << 16, mmu, ra);
+        }
+    }
+    x[16] = 1;
+}
