+/*
+ * QuartzCore (18A373) CA::OGL::SW::Blend::Mode<Sover, true>::blend(dst, back,
+ * top, count): one row through vImagePremultipliedAlphaBlend_BGRA8888 (top over
+ * back into dst, kvImageDoNotTile), so the same pixels as hypercall 11 for a
+ * row of count pixels, without vImage's per-call thread and QoS queries.
+ */
+static void ios_hcall_ca_sover_blend(CPUARMState *env, uintptr_t ra)
+{
+    uint64_t *x = env->xregs;
+    int mmu = arm_env_mmu_index(env);
+    CaCache tc, bc, dc;
+    uint64_t dst = x[0], back = x[1], top = x[2], count = x[3];
+    uint64_t vec = count >= 8 ? count & ~(uint64_t)7 : 0;
+
+    ca_cache_init(&tc);
+    ca_cache_init(&bc);
+    ca_cache_init(&dc);
+    for (uint64_t i = 0; i < count; i++) {
+        uint32_t t = ca_ld32(env, &tc, top + 4 * i, mmu, ra);
+        uint32_t b = ca_ld32(env, &bc, back + 4 * i, mmu, ra);
+        ca_st32(env, &dc, dst + 4 * i,
+                i < vec ? vimage_blend_vec(t, b) : vimage_blend_scalar(t, b),
+                mmu, ra);
+    }
+}
